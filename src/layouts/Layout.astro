---
import "../styles/globals.css";
import LoadingScreen from "@/components/LoadingScreen.astro";
import SmoothScrollProvider from "@/components/smoothui/SmoothScrollProvider.astro";
import CurtainsProvider from "@/components/CurtainsProvider.astro";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: "website" | "article";
  pubDate?: Date;
  author?: string;
  tags?: string[];
  localFonts?: boolean;
  noIndex?: boolean;
  skipLoader?: boolean;
}

const {
  title,
  description,
  image,
  canonicalURL,
  type = "website",
  pubDate,
  author = "NextReach Studio",
  tags = [],
  localFonts = false,
  noIndex = false,
  skipLoader = false,
} = Astro.props;

const siteURL = "https://www.nextreachstudio.in";

// The studio's self-description — used for the Organization and WebSite entities, and
// nowhere else.
//
// It is deliberately NOT the page's description. Both entities are referenced by a stable
// @id from every URL, so their properties must say the same thing everywhere. Feeding them
// the page description meant the Organization was a different business on every URL — a
// studio about "how much does SEO cost in Pune" on one page, a restaurant demo on the next.
// An entity that redefines itself per URL is worse than one with no description at all.
const STUDIO_DESCRIPTION =
  "NextReach Studio is a software studio in Pune, India. We build custom websites, web applications, and AI systems for businesses — designed, written, and delivered by the same senior engineer you talk to, on fixed scope.";

// Fallbacks only — every page currently passes its own. They exist so that a new page which
// forgets to cannot silently describe the studio as an AI-tools blog, which is what the
// previous fallback did (and what it was still doing in the site's meta description).
const siteTitle = title ? `${title} | NextReach Studio` : "NextReach Studio - Custom Websites, Web Apps & AI Systems";
const siteDescription = description || STUDIO_DESCRIPTION;
const ogImage = image ? (image.startsWith("http") ? image : `${siteURL}${image}`) : `${siteURL}/link-previews.jpg`;
const canonical = canonicalURL || Astro.url.href;

const breadcrumbItems = (() => {
  const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
  const segments = path.split("/").filter(Boolean);
  const items = [{ name: "Home", path: "/" }];
  let current = "";
  for (const seg of segments) {
    current += "/" + seg;
    const label = seg.replace(/[-_]/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
    items.push({ name: label, path: current });
  }
  return items;
})();

// Canonical entity IDs — referenced across every schema block so the graph connects
// rather than repeating disconnected facts on each page.
const ORG_ID = `${siteURL}/#organization`;
const PERSON_ID = `${siteURL}/about/#person`;
const WEBSITE_ID = `${siteURL}/#website`;

// Standardised contact facts. These MUST match the Google Business Profile exactly —
// inconsistent NAP across surfaces is the single most common local-SEO failure, and it
// actively feeds AI hallucination about the business.
//
// GBP is configured as a SERVICE-AREA business (no published address), so no
// PostalAddress is declared here. Phone is E.164 everywhere; the GBP listing currently
// shows a local-format number that needs updating to match.
export const CONTACT = {
  phone: "+919822379976",
  phoneDisplay: "+91 98223 79976",
  email: "hello@nextreachstudio.in",
  hours: [
    "Mo", "Tu", "We", "Th", "Fr", "Sa", "Su",
  ],
  opens: "09:00",
  closes: "19:00",
  areaServed: ["Pune", "Pimpri-Chinchwad", "Maharashtra"],
};

// Founder entity. Backs the studio's core positioning (direct senior engineer
// access) with a named, verifiable person rather than a generic brand string.
const founder = {
  "@type": "Person",
  "@id": PERSON_ID,
  "name": "Rajesh Shrirao",
  "jobTitle": "Founder & Principal Engineer",
  "description":
    "Founder and principal engineer at NextReach Studio. Builds custom web applications, AI systems, and automation for businesses from Pune, India. Works directly with every client rather than through account managers.",
  "url": `${siteURL}/about/`,
  "worksFor": { "@id": ORG_ID },
  "knowsAbout": [
    "Web application development",
    "AI agent development",
    "Business process automation",
    "API integration",
    "Astro",
    "Next.js",
    "PostgreSQL",
    "LLM integration",
    "MCP",
  ],
  "sameAs": [
    "https://www.linkedin.com/in/rajesh-shrirao-1ab80b395/",
    "https://www.instagram.com/rajesh.shrirao/",
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={canonical} />

    {localFonts ? (
      <>
        <link rel="preload" href="/fonts/cabinet-grotesk-variable.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
      </>
    ) : (
    <>
    <!-- Fonts: non-render-blocking via preload + swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap" />
    <link rel="preload" as="style" href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@400,500,700,800&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <link href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@400,500,700,800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
      <link href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@400,500,700,800&display=swap" rel="stylesheet" />
    </noscript>
    </>
    )}

    <slot name="head" />

    <!-- Icons & PWA -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#2A2A2D" />
    <meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow"} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="NextReach Studio Blog" href="/rss.xml" />

    <!-- Google Analytics (deferred until idle/post-paint to protect FCP & main thread) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', 'G-1DVFSD0J9Y');

      function initGA() {
        if (window.__gaInitialized) return;
        window.__gaInitialized = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-1DVFSD0J9Y';
        document.head.appendChild(s);
      }

      var triggerGA = function() {
        initGA();
        ['scroll', 'touchstart', 'pointerdown', 'keydown'].forEach(function(e) {
          window.removeEventListener(e, triggerGA, { passive: true });
        });
      };
      ['scroll', 'touchstart', 'pointerdown', 'keydown'].forEach(function(e) {
        window.addEventListener(e, triggerGA, { passive: true, once: true });
      });

      if ('requestIdleCallback' in window) {
        requestIdleCallback(function() { setTimeout(initGA, 5000); });
      } else {
        window.addEventListener('load', function() { setTimeout(initGA, 5000); }, { once: true });
      }

      // Conversion events are deliberately small and action-oriented. Campaign pages
      // add data-track attributes; this keeps the same event names usable in GA4 and
      // avoids collecting message contents, names, phone numbers, or other PII.
      document.addEventListener('click', function(event) {
        var target = event.target;
        var link = target && target.closest ? target.closest('[data-track]') : null;
        if (!link) return;
        var eventName = link.hasAttribute('data-whatsapp-cta') ? 'whatsapp_cta_clicked' : 'cta_clicked';
        window.gtag('event', eventName, {
          cta_name: link.getAttribute('data-track'),
          cta_location: window.location.pathname,
          package: link.getAttribute('data-package') || undefined,
        });
      });
    </script>

    <!-- Open Graph -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="NextReach Studio" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@nextreachstudio" />
    <meta name="twitter:creator" content="@nextreachstudio" />

    <!-- Article-specific meta -->
    {type === "article" && pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    )}
    {type === "article" && author && (
      <meta property="article:author" content={author} />
    )}
    {type === "article" && tags.length > 0 && tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Structured Data: BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbItems.map((item, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": item.name,
        "item": `${siteURL}${item.path}`,
      })),
    })} />

    <!-- Security Headers (meta tags for docs/guidance; X-Frame-Options must be set via server header) -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />

    <!-- Structured Data: WebSite — references the Organization by @id -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": WEBSITE_ID,
      "name": "NextReach Studio",
      "url": siteURL,
      "description": STUDIO_DESCRIPTION,
      "publisher": { "@id": ORG_ID },
      "inLanguage": "en-IN",
    })} />

    <!-- Structured Data: Organization + founder (Person entity).
         addressLocality is Chakan: the studio is home-based, so the honest locality
         is the residential one. Google requires the site address to match whatever
         is set on the Business Profile — keep the two identical. -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": ORG_ID,
      "name": "NextReach Studio",
      "disambiguatingDescription": "Independent software and AI engineering studio based in Pune, India, operating at nextreachstudio.in. Not affiliated with any other company using the name NextReach.",
      "url": siteURL,
      "logo": `${siteURL}/logo.png`,
      "image": `${siteURL}/link-previews.jpg`,
      "description": STUDIO_DESCRIPTION,
      "email": CONTACT.email,
      "telephone": CONTACT.phone,
      "founder": { "@id": PERSON_ID },
      // Service-area business: the Google Business Profile hides the street address, so
      // none is declared here either. Declare areaServed instead. Do NOT add a
      // PostalAddress unless the GBP switches to showing one — the two must agree.
      "areaServed": [
        { "@type": "City", "name": "Pune", "@id": "https://www.wikidata.org/wiki/Q129563" },
        { "@type": "AdministrativeArea", "name": "Pimpri-Chinchwad" },
        { "@type": "AdministrativeArea", "name": "Maharashtra" },
        { "@type": "Country", "name": "India" },
      ],
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": CONTACT.hours,
          "opens": CONTACT.opens,
          "closes": CONTACT.closes,
        },
      ],
      "knowsAbout": [
        "Web application development",
        "AI agent development",
        "Business process automation",
        "API integration",
        "MVP development",
        "Website design",
      ],
      "sameAs": [
        "https://www.linkedin.com/in/rajesh-shrirao-1ab80b395/",
        "https://www.instagram.com/rajesh.shrirao/",
        "https://www.instagram.com/nextreach.studio/",
      ],
    })} />

    <!-- Structured Data: Person — founder entity, declared once site-wide so every
         Article below references it by @id instead of repeating a name string. -->
    <script type="application/ld+json" set:html={JSON.stringify(founder)} />

    <!-- Structured Data: Article (if article type) -->
    {type === "article" && pubDate && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        "@id": `${canonical}#article`,
        "mainEntityOfPage": { "@type": "WebPage", "@id": canonical },
        "headline": title,
        "description": siteDescription,
        "image": ogImage,
        "inLanguage": "en-IN",
        // Written and owned by the principal engineer, so the author is the Person
        // entity rather than the brand string.
        "author": { "@id": PERSON_ID },
        "publisher": { "@id": ORG_ID },
        "datePublished": pubDate.toISOString(),
        "url": canonical,
        ...(tags.length > 0 ? { keywords: tags.join(", ") } : {}),
      })} />
    )}
  </head>
  <body class="site-shell font-body antialiased min-h-screen">
    {!skipLoader && <LoadingScreen />}
    <SmoothScrollProvider />
    <CurtainsProvider />
    <div data-site-content>
      <slot />
    </div>
  </body>
</html>
