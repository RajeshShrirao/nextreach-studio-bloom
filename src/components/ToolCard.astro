---
export interface Props {
  name: string;
  description: string;
  href: string;
  tags?: string[];
  badge?: string;
  icon?: string;
}

const { name, description, href, tags = [], badge, icon } = Astro.props;
---

<a
  href={href}
  class="card-studio-accent group hover:border-[#C76B50]/45 shadow-sm"
>
  <div class="flex items-start gap-4">
    {icon && (
      <div class="icon-glow-wrapper shrink-0 w-10 h-10 rounded-xl text-base shadow-sm">
        {icon}
      </div>
    )}
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2 mb-1.5">
        <h3 class="font-bold text-[#1F1F23] group-hover:text-[#C76B50] transition-colors text-sm leading-snug font-display">
          {name}
        </h3>
        {badge && (
          <span class="badge-premium-accent font-mono text-[9px]">
            {badge}
          </span>
        )}
      </div>
      <p class="text-xs text-[#6E6862] leading-relaxed line-clamp-2 transition-colors group-hover:text-[#4A4844] font-body">{description}</p>
      {tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="badge-premium-neutral font-mono text-[9px]">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 shrink-0 text-[#8C847B] group-hover:text-[#C76B50] transition-all duration-200 group-hover:translate-x-1 mt-0.5">
      <path d="M9 18l6-6-6-6"/>
    </svg>
  </div>
</a>
