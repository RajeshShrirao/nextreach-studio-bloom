---
import { CpuIcon, LightningIcon, CodeIcon, ShieldCheckIcon } from "@phosphor-icons/react";

const specs = [
  {
    index: "01",
    tag: "ENGINE ARCHITECTURE",
    title: "Astro 6 + React 19",
    metric: "0kb JS Default",
    detail: "Static-first HTML delivery with zero unnecessary hydration bloat.",
    icon: CpuIcon,
  },
  {
    index: "02",
    tag: "SPEED BENCHMARK",
    title: "Sub-0.8s LCP",
    metric: "100/100 Core Web Vitals",
    detail: "Instant page loads on 4G mobile. Zero layout shift across devices.",
    icon: LightningIcon,
  },
  {
    index: "03",
    tag: "CODE INTEGRITY",
    title: "TypeScript + Tailwind 4",
    metric: "Zero Plugin Bloat",
    detail: "Handcrafted, clean maintainable code built for long-term reliability.",
    icon: CodeIcon,
  },
  {
    index: "04",
    tag: "ASSET CONTROL",
    title: "100% IP Ownership",
    metric: "Day-One Git Handover",
    detail: "Full repository rights and domain keys. Zero vendor lock-in retainers.",
    icon: ShieldCheckIcon,
  },
];
---

<section class="studio-spec-section studio-container" aria-label="Studio technical specifications and standards">
  <div class="studio-spec-grid" data-reveal>
    {specs.map((item) => (
      <div class="studio-spec-card">
        <div class="studio-spec-header">
          <span class="studio-spec-index">{item.index}</span>
          <span class="studio-spec-tag">{item.tag}</span>
          <item.icon size={18} weight="light" className="studio-spec-icon" />
        </div>
        <div class="studio-spec-body">
          <h3 class="studio-spec-title">{item.title}</h3>
          <p class="studio-spec-metric">{item.metric}</p>
          <p class="studio-spec-detail">{item.detail}</p>
        </div>
      </div>
    ))}
  </div>
</section>
