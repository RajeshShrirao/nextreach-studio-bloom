---
import { CheckIcon, XIcon, ArrowUpRightIcon } from "@phosphor-icons/react";

const comparisons = [
  {
    feature: "Launch Timeline",
    studio: "1 to 3 Days guaranteed for fixed-scope packages",
    agency: "6 to 8 weeks of delays and endless alignment meetings",
  },
  {
    feature: "Who Writes Your Code",
    studio: "Direct collaboration with the Senior Engineer & Designer",
    agency: "Handed off to junior interns and non-technical account managers",
  },
  {
    feature: "Code & Asset Ownership",
    studio: "100% full Git repository, domain, and asset keys on day one",
    agency: "Proprietary lock-in, hostage hosting, and monthly maintenance traps",
  },
  {
    feature: "Performance & Architecture",
    studio: "Sub-second load times with zero third-party plugin bloat",
    agency: "45-plugin WordPress setups that crawl on mobile connections",
  },
  {
    feature: "Pricing & Scope Transparency",
    studio: "Fixed-price scope lock with zero hidden fees or surprise invoices",
    agency: "Vague estimates that double in cost through hourly change orders",
  },
];
---

<section class="studio-comparison studio-container studio-section" id="studio-standard" aria-labelledby="comparison-title">
  <div class="studio-section-title" data-reveal>
    <div>
      <h2 id="comparison-title">The studio standard.<br /><span class="studio-muted">No agency games.</span></h2>
    </div>
    <a href="/contact" class="studio-text-link">Start a clean project <ArrowUpRightIcon size={20} /></a>
  </div>

  <div class="studio-comparison-table" data-reveal>
    <div class="studio-comparison-header">
      <div class="studio-col-factor">CRITICAL FACTOR</div>
      <div class="studio-col-studio">
        <span class="studio-badge-accent">THE NEXTREACH STANDARD</span>
        <p>How we build for you</p>
      </div>
      <div class="studio-col-legacy">
        <span class="studio-badge-muted">TYPICAL AGENCY TRAP</span>
        <p>What happens elsewhere</p>
      </div>
    </div>

    <div class="studio-comparison-rows">
      {comparisons.map((row) => (
        <div class="studio-comparison-row">
          <div class="studio-cell-factor">
            <span class="studio-factor-label">{row.feature}</span>
          </div>
          <div class="studio-cell-studio">
            <span class="studio-status-icon studio-icon-check" aria-hidden="true">
              <CheckIcon size={16} weight="bold" />
            </span>
            <p>{row.studio}</p>
          </div>
          <div class="studio-cell-legacy">
            <span class="studio-status-icon studio-icon-x" aria-hidden="true">
              <XIcon size={16} weight="bold" />
            </span>
            <p>{row.agency}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
