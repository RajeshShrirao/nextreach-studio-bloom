---
export interface Props {
  title: string;
  description: string;
  href: string;
  category?: string;
  tags?: string[];
  external?: boolean;
}

const { title, description, href, category, tags = [], external = false } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class="card-studio group flex flex-col hover:border-[#c76b50]/30"
>
  <div class="flex items-start justify-between gap-3 mb-3">
    <div class="min-w-0 flex-1">
      {category && (
        <p class="text-xs font-semibold text-[#c76b50] uppercase tracking-wider mb-1 font-mono">{category}</p>
      )}
      <h3 class="font-semibold text-white group-hover:text-[#c76b50] transition-colors text-sm leading-snug font-display">
        {title}
      </h3>
    </div>
    {external ? (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 shrink-0 text-[#78716c] group-hover:text-[#f5f1e9] transition-all duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 mt-0.5">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        <polyline points="15 3 21 3 21 9"/>
        <line x1="10" y1="14" x2="21" y2="3"/>
      </svg>
    ) : (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 shrink-0 text-[#78716c] group-hover:text-[#c76b50] transition-all duration-200 group-hover:translate-x-1 mt-0.5">
        <path d="M9 18l6-6-6-6"/>
      </svg>
    )}
  </div>
  <p class="text-xs text-[#a69d92] leading-relaxed flex-1 transition-colors group-hover:text-[#d1cbc1] font-body">{description}</p>
  {tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <span class="badge-premium-neutral font-mono text-[10px]">
          {tag}
        </span>
      ))}
    </div>
  )}
</a>
