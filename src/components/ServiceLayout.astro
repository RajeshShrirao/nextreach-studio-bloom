---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";

export interface Props {
  title: string;
  description: string;
  serviceTag: string;
  headline: string;
  subheadline: string;
  offerings: { title: string; description: string }[];
  idealClient: string;
  timeline: string;
  priceRange: string;
  ctaText?: string;
  ctaHref?: string;
  relatedLinks?: { href: string; label: string }[];
  researchLinks?: { href: string; label: string; note: string }[];
  portfolioTags?: string[];
}

const {
  title,
  description,
  serviceTag,
  headline,
  subheadline,
  offerings,
  idealClient,
  timeline,
  priceRange,
  ctaText = "Schedule a Technical Discovery Call",
  ctaHref = "/contact",
  relatedLinks,
  researchLinks,
  portfolioTags,
} = Astro.props;

// Must match the @id values declared in Layout.astro so the entity graph connects.
const siteURL = "https://nextreachstudio.vercel.app";
const ORG_ID = `${siteURL}/#organization`;

const structuredOffering = offerings.map((o, i) => ({
  "@type": "ListItem",
  position: i + 1,
  item: { "@type": "Service", name: o.title, description: o.description },
}));
---

<Layout title={title} description={description}>
  <!-- Provider referenced by @id so this connects to the Organization entity declared
       in Layout.astro rather than repeating the brand as a separate node. -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${siteURL}${Astro.url.pathname}#service`,
    name: serviceTag,
    serviceType: serviceTag,
    description: subheadline,
    provider: { "@id": ORG_ID },
    offers: { "@type": "Offer", price: priceRange, priceCurrency: "USD" },
    areaServed: [
      { "@type": "City", name: "Pune" },
      { "@type": "AdministrativeArea", name: "Maharashtra" },
    ],
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "@id": `${siteURL}${Astro.url.pathname}#offerings`,
    name: `${serviceTag} capabilities`,
    itemListElement: structuredOffering,
  })} />
  <Nav />
  <main class="container-page-wide relative pt-28">
    <div class="absolute top-0 left-1/4 -translate-y-12 w-[500px] h-[300px] bg-[#C76B50]/6 rounded-full blur-[110px] pointer-events-none -z-10" aria-hidden="true"></div>

    <header class="text-center max-w-3xl mx-auto px-4 mb-16 stagger-parent">
      <p class="text-xs font-mono uppercase tracking-[0.2em] text-[#C76B50] font-semibold mb-4">{serviceTag}</p>
      <h1 class="text-hero text-[#1F1F23] mb-6 font-display font-bold text-balance-wide">{headline}</h1>
      <p class="text-[#6E6862] text-base sm:text-lg leading-relaxed font-body">{subheadline}</p>
    </header>

    <div class="max-w-4xl mx-auto px-4 mb-16 space-y-6 stagger-parent">
      {offerings.map((o) => (
        <div class="card-studio p-6 sm:p-8 shadow-sm">
          <h2 class="text-lg sm:text-xl font-bold text-[#1F1F23] font-display mb-3">{o.title}</h2>
          <p class="text-sm text-[#6E6862] leading-relaxed font-body">{o.description}</p>
        </div>
      ))}
    </div>

    <slot />

    <div class="max-w-4xl mx-auto px-4 mb-16">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="dashboard-panel p-4 text-center shadow-sm">
          <p class="text-[10px] text-[#6E6862] font-mono mb-1">Ideal Client</p>
          <p class="text-sm text-[#1F1F23] font-semibold">{idealClient}</p>
        </div>
        <div class="dashboard-panel p-4 text-center shadow-sm">
          <p class="text-[10px] text-[#6E6862] font-mono mb-1">Timeline</p>
          <p class="text-sm text-[#1F1F23] font-semibold">{timeline}</p>
        </div>
        <div class="dashboard-panel p-4 text-center shadow-sm">
          <p class="text-[10px] text-[#6E6862] font-mono mb-1">Price Range</p>
          <p class="text-sm text-[#1F1F23] font-semibold">{priceRange}</p>
        </div>
      </div>
    </div>

    {researchLinks && researchLinks.length > 0 && (
      <div class="max-w-4xl mx-auto px-4 mb-16 stagger-parent">
        <div class="text-center mb-6">
          <p class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#6E6862] font-semibold mb-2">Research</p>
          <h2 class="text-lg font-bold text-[#1F1F23] font-display">Read Before You Decide</h2>
        </div>
        <div
          class:list={[
            "grid gap-4",
            researchLinks.length === 1
              ? "grid-cols-1 sm:grid-cols-1"
              : researchLinks.length === 2
                ? "grid-cols-1 sm:grid-cols-2"
                : researchLinks.length === 3
                  ? "grid-cols-1 sm:grid-cols-3"
                  : "grid-cols-1 sm:grid-cols-2",
          ]}
        >
          {researchLinks.map(({ href, label, note }) => (
            <a href={href} class="card-studio group flex flex-col">
              <h3 class="text-sm font-bold text-[#1F1F23] font-display mb-2 leading-snug group-hover:text-[#C76B50] transition-colors">{label}</h3>
              <p class="text-xs text-[#6E6862] leading-relaxed font-body">{note}</p>
              <span class="text-[10px] font-mono text-[#C76B50] mt-auto pt-3">Read →</span>
            </a>
          ))}
        </div>
      </div>
    )}

    {relatedLinks && relatedLinks.length > 0 && (
      <div class="max-w-4xl mx-auto px-4 mb-16 stagger-parent">
        <h2 class="text-lg font-bold text-[#1F1F23] font-display mb-4 text-center">Explore More</h2>
        <div class="flex flex-wrap justify-center gap-3">
          {relatedLinks.map(({ href, label }) => (
            <a href={href} class="px-4 py-2 rounded-lg text-sm text-[#4A4844] bg-white border border-[#1F1F23]/8 hover:text-[#C76B50] hover:border-[#C76B50]/30 transition-all duration-200 shadow-sm">
              {label}
            </a>
          ))}
        </div>
      </div>
    )}

    {portfolioTags && portfolioTags.length > 0 && (
      <div class="max-w-4xl mx-auto px-4 mb-16 stagger-parent text-center">
        <p class="text-[#6E6862] text-sm">
          See related work:{" "}
          <a href="/portfolio" class="text-[#C76B50] hover:text-[#D97A5E] underline underline-offset-2 transition-colors font-medium">View our portfolio</a>
        </p>
      </div>
    )}

    <div class="text-center max-w-4xl mx-auto px-4 mb-20 stagger-parent">
      <p class="text-[#6E6862] text-sm sm:text-base mb-6 font-body">Ready to get started?</p>
      <a href={ctaHref} class="btn-premium-primary">
        {ctaText}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </main>
  <Footer />
</Layout>
