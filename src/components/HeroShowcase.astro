<div class="hero-showcase" data-tilt-card>
  <div class="hero-showcase__glow" aria-hidden="true"></div>
  <div class="hero-showcase__frame gradient-border">
    <div class="hero-showcase__chrome" aria-hidden="true">
      <span></span><span></span><span></span>
      <div class="hero-showcase__chrome-line"></div>
      <span class="hero-showcase__chrome-dot"></span>
    </div>
    <div class="hero-showcase__media">
      <img
        src="/assets/hero-dashboard-preview.webp"
        alt="NextReach Studio - dark analytics dashboard with amber and blue performance charts showing system metrics"
        width="1600"
        height="900"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-showcase__scrim" aria-hidden="true"></div>
      <div class="hero-showcase__badge">
        <span class="status-dot status-dot--live"></span>
        <span>Production System Active</span>
      </div>
      <div class="hero-showcase__metric">
        <span class="hero-showcase__metric-label">Delivery velocity</span>
        <strong>+42.8%</strong>
        <span class="hero-showcase__metric-trend">↗ this sprint</span>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-showcase { position: relative; perspective: 1200px; max-width: 1024px; margin: 0 auto; }
  .hero-showcase__glow { position: absolute; inset: 8% 10%; background: radial-gradient(ellipse, rgba(245,158,11,.22), transparent 66%); filter: blur(56px); pointer-events: none; }
  .hero-showcase__frame { position: relative; z-index: 1; padding: 9px; border-radius: 22px; background: rgba(12,12,14,.72); box-shadow: 0 32px 80px rgba(0,0,0,.54), 0 0 80px rgba(245,158,11,.1); transform: rotateX(3deg) rotateY(-2deg); transition: transform .25s ease-out, box-shadow .3s ease; will-change: transform; }
  .hero-showcase__frame:hover { box-shadow: 0 40px 90px rgba(0,0,0,.66), 0 0 100px rgba(245,158,11,.16); }
  .hero-showcase__chrome { display: flex; align-items: center; gap: 6px; height: 28px; padding: 0 10px; border-radius: 14px 14px 0 0; background: rgba(255,255,255,.035); }
  .hero-showcase__chrome > span:not(.hero-showcase__chrome-dot) { width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,.2); }
  .hero-showcase__chrome > span:first-child { background: #f59e0b; box-shadow: 0 0 9px rgba(245,158,11,.75); }
  .hero-showcase__chrome-line { width: 110px; height: 5px; margin-left: 12px; border-radius: 99px; background: rgba(255,255,255,.08); }
  .hero-showcase__chrome-dot { width: 6px; height: 6px; margin-left: auto; border-radius: 50%; background: #34d399; box-shadow: 0 0 9px rgba(52,211,153,.65); }
  .hero-showcase__media { position: relative; overflow: hidden; border-radius: 0 0 15px 15px; background: #0b0b0c; }
  .hero-showcase__media img { display: block; width: 100%; height: auto; }
  .hero-showcase__badge, .hero-showcase__metric { position: absolute; display: flex; align-items: center; gap: 8px; border: 1px solid rgba(255,255,255,.14); background: #131316; box-shadow: 0 10px 30px rgba(0,0,0,.3); color: #e4e4e7; font: 600 10px/1 var(--font-mono); letter-spacing: .02em; }
  .hero-showcase__badge { top: 18px; right: 18px; padding: 8px 12px; border-radius: 6px; }
  .hero-showcase__metric { bottom: 18px; left: 18px; flex-wrap: wrap; max-width: 170px; padding: 12px; border-radius: 8px; }
  .hero-showcase__metric-label { width: 100%; color: #a1a1aa; font-size: 9px; }
  .hero-showcase__metric strong { color: #fbbf24; font: 700 18px/1 var(--font-display); }
  .hero-showcase__metric-trend { color: #34d399; font-size: 9px; }
  .status-dot { width: 7px; height: 7px; border-radius: 50%; }
  .status-dot--live { background: #34d399; box-shadow: 0 0 0 4px rgba(52,211,153,.12), 0 0 12px rgba(52,211,153,.8); animation: pulse-live 2s ease-in-out infinite; }
  @keyframes pulse-live { 50% { opacity: .48; transform: scale(.82); } }
  @media (max-width: 640px) { .hero-showcase__frame { padding: 6px; border-radius: 16px; } .hero-showcase__chrome { height: 22px; } .hero-showcase__badge { top: 10px; right: 10px; padding: 8px 9px; font-size: 8px; } .hero-showcase__metric { bottom: 10px; left: 10px; padding: 9px; } }
</style>

<script>
  const tiltCard = document.querySelector<HTMLElement>('[data-tilt-card]');
  const frame = tiltCard?.querySelector<HTMLElement>('.hero-showcase__frame');
  if (tiltCard && frame && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    tiltCard.addEventListener('pointermove', (event) => {
      const rect = tiltCard.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - 0.5;
      const y = (event.clientY - rect.top) / rect.height - 0.5;
      frame.style.transform = `rotateX(${3 - y * 5}deg) rotateY(${-2 + x * 7}deg) translateZ(4px)`;
    });
    tiltCard.addEventListener('pointerleave', () => { frame.style.transform = 'rotateX(3deg) rotateY(-2deg)'; });
  }
</script>
