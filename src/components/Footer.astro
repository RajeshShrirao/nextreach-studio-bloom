---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[#1F1F23]/8 mt-24 py-12 px-6 sm:px-8 bg-[#F0ECE4]/60">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 mb-10">
      <!-- Agency Profile column -->
      <div class="col-span-2 sm:col-span-1">
        <a href="/" class="flex items-center gap-2.5 mb-3 group" aria-label="NextReach Studio">
          <img src="/logo.svg" alt="NextReach Studio" width="28" height="28" class="rounded-md opacity-95 group-hover:opacity-100 transition-opacity" />
          <span class="text-sm font-bold text-[#1F1F23] group-hover:text-[#C76B50] transition-colors font-display">
            NextReach <span class="text-[#C76B50]">Studio</span>
          </span>
        </a>
        <p class="text-xs text-[#6E6862] leading-relaxed max-w-[220px] font-body mb-3">
          Senior-engineered custom websites, web applications, and autonomous AI workflows. Fixed-scope investment clarity. Shipped in days, not quarters.
        </p>
        <a
          href="https://wa.me/919822379976"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-[#C76B50] hover:text-[#D97A5E] transition-colors"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 text-emerald-600">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.99.54 1.787.876 2.796.877 3.177 0 5.764-2.587 5.765-5.766.001-3.181-2.585-5.764-5.765-5.764zm0-2c4.28 0 7.765 3.483 7.765 7.764 0 4.281-3.485 7.766-7.765 7.766-.001 0-.001 0 0 0-1.298 0-2.434-.336-3.466-.948l-4.565 1.196 1.218-4.453c-.696-1.107-1.077-2.313-1.077-3.561 0-4.281 3.484-7.764 7.765-7.764zm-2.031 6.586c-.167-.367-.344-.374-.504-.381-.131-.006-.281-.006-.431-.006s-.394.056-.6.281c-.206.225-.788.769-.788 1.875s.806 2.175.919 2.325c.112.15 1.556 2.493 3.844 3.403 1.902.756 2.288.606 2.7.568.413-.037 1.331-.544 1.519-1.069.188-.525.188-.975.131-1.069-.056-.094-.206-.15-.431-.263s-1.331-.656-1.538-.731-.356-.113-.506.113c-.15.225-.581.731-.712.881-.131.15-.262.169-.488.056-.225-.113-.949-.35-1.808-1.115-.668-.596-1.119-1.332-1.25-1.557s-.014-.347.098-.459c.101-.101.225-.262.338-.394s.15-.225.225-.375c.075-.15.038-.281-.019-.394s-.504-1.259-.701-1.69z"/>
          </svg>
          <span>WhatsApp: +91 98223 79976</span>
        </a>
      </div>

      <!-- Services & Packages column -->
      <div>
        <h3 class="text-xs font-bold text-[#1F1F23] uppercase tracking-wider mb-3 font-mono">Solutions</h3>
        <ul class="space-y-2">
          <li><a href="/#packages" class="text-xs text-[#C76B50] hover:text-[#D97A5E] font-bold transition-colors">Website Packages (₹5k+)</a></li>
          <li><a href="/services" class="text-xs text-[#6E6862] hover:text-[#1F1F23] transition-colors">Custom Web Platforms</a></li>
          <li><a href="/services" class="text-xs text-[#6E6862] hover:text-[#1F1F23] transition-colors">Autonomous AI Agents</a></li>
          <li><a href="/services" class="text-xs text-[#6E6862] hover:text-[#1F1F23] transition-colors">Business Automation</a></li>
          <li><a href="/services" class="text-xs text-[#6E6862] hover:text-[#1F1F23] transition-colors">Rapid MVP Engineering</a></li>
        </ul>
      </div>

      <!-- Agency Pages column -->
      <div>
        <h3 class="text-xs font-bold text-[#1F1F23] uppercase tracking-wider mb-3 font-mono">Studio</h3>
        <ul class="space-y-2">
          <li><a href="/portfolio" class="text-xs text-[#6E6862] hover:text-[#1F1F23] transition-colors">Portfolio &amp; Case Studies</a></li>
          <li><a href="/demos/saffron-and-smoke" class="text-xs text-[#6E6862] hover:text-[#1F1F23] transition-colors">Saffron &amp; Smoke Flagship</a></li>
          <li><a href="/about" class="text-xs text-[#6E6862] hover:text-[#1F1F23] transition-colors">About the Studio</a></li>
          <li><a href="/contact" class="text-xs text-[#6E6862] hover:text-[#1F1F23] transition-colors">Contact / Book Sprint</a></li>
          <li><a href="/privacy" class="text-xs text-[#6E6862] hover:text-[#1F1F23] transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="text-xs text-[#6E6862] hover:text-[#1F1F23] transition-colors">Terms of Service</a></li>
        </ul>
      </div>

      <!-- NextReach Labs column -->
      <div>
        <h3 class="text-xs font-bold text-[#1F1F23] uppercase tracking-wider mb-3 font-mono">NextReach Labs (R&amp;D)</h3>
        <ul class="space-y-2">
          <li><a href="/tools" class="text-xs text-[#6E6862] hover:text-[#1F1F23] transition-colors">AI Developer Tools Hub</a></li>
          <li><a href="/tools/ai-token-calculator" class="text-xs text-[#6E6862] hover:text-[#1F1F23] transition-colors">Token Calculator</a></li>
          <li><a href="/tools/vram-estimator" class="text-xs text-[#6E6862] hover:text-[#1F1F23] transition-colors">VRAM Estimator</a></li>
          <li><a href="/blog" class="text-xs text-[#6E6862] hover:text-[#1F1F23] transition-colors">Research &amp; Blog</a></li>
          <li><a href="/guides" class="text-xs text-[#6E6862] hover:text-[#1F1F23] transition-colors">Technical Guides</a></li>
        </ul>
      </div>
    </div>

    <div class="gradient-divider mb-6"></div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-[#8C847B]">&copy; {currentYear} NextReach Studio. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="/rss.xml" class="text-xs text-[#8C847B] hover:text-[#1F1F23] transition-colors">RSS Feed</a>
        <a href="/sitemap-index.xml" class="text-xs text-[#8C847B] hover:text-[#1F1F23] transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
