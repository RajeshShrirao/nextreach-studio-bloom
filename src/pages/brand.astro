---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import BrandKitViewer from "@/components/brand/BrandKitViewer";

const pageTitle = "Brand Kit, Logo Assets & Identity System | NextReach Studio";
const pageDescription = "Official NextReach Studio brand assets, vector SVG logos, emblem construction blueprints, color palette tokens, typography rules, clear-space specifications, and usage guidelines.";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.nextreachstudio.in/brand#webpage",
      "url": "https://www.nextreachstudio.in/brand",
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://www.nextreachstudio.in/#website",
        "name": "NextReach Studio",
        "url": "https://www.nextreachstudio.in/"
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://www.nextreachstudio.in/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Brand Kit",
            "item": "https://www.nextreachstudio.in/brand"
          }
        ]
      }
    },
    {
      "@type": "Brand",
      "@id": "https://www.nextreachstudio.in/#brand",
      "name": "NextReach Studio",
      "alternateName": "NextReach",
      "url": "https://www.nextreachstudio.in/",
      "logo": "https://www.nextreachstudio.in/brand/logo-horizontal.svg",
      "slogan": "High-Velocity AI & Web Engineering"
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Nav />

  <main class="min-h-screen pt-28 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <!-- Ambient radial glow behind the hero -->
    <div class="absolute top-20 left-1/2 -translate-x-1/2 w-[700px] h-[380px] bg-[#C76B50]/8 rounded-full blur-[140px] pointer-events-none -z-10" aria-hidden="true"></div>

    <!-- Header Section -->
    <header class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#C76B50]/10 border border-[#C76B50]/20 text-[#C76B50] text-xs font-mono font-bold mb-4">
        <span>Official Brand &amp; Identity Guidelines</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold font-display text-[#1F1F23] tracking-tight mb-4">
        NextReach Studio Brand Kit
      </h1>
      <p class="text-sm sm:text-base text-[#6E6862] leading-relaxed font-body">
        The official visual system, production SVG logotypes, architectural monogram blueprints, color architecture tokens, and strict usage guidelines for partners, press, and client flagships.
      </p>

      <!-- Quick Action Pill Group -->
      <div class="flex flex-wrap items-center justify-center gap-2.5 mt-6">
        <a
          href="/brand/logo-horizontal.svg"
          download
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold font-mono bg-[#1F1F23] text-white hover:bg-[#C76B50] transition-colors shadow-sm"
          title="Download Vector SVG Logo"
        >
          <svg class="w-3.5 h-3.5 text-[#C76B50]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Logo (SVG)</span>
        </a>
        <a
          href="/brand/logo-horizontal.png"
          download
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold font-mono bg-[#C76B50]/10 text-[#C76B50] border border-[#C76B50]/30 hover:bg-[#C76B50] hover:text-white transition-all shadow-sm"
          title="Download High-Res 300 DPI PNG Logo"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Logo (PNG HD)</span>
        </a>
        <a
          href="/brand/app-icon.svg"
          download
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold font-mono bg-white text-[#1F1F23] border border-[#1F1F23]/10 hover:border-[#C76B50] hover:text-[#C76B50] transition-colors shadow-sm"
          title="Download Vector SVG App Icon"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>App Icon (SVG)</span>
        </a>
        <a
          href="/brand/app-icon.png"
          download
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold font-mono bg-white text-[#1F1F23] border border-[#1F1F23]/10 hover:border-[#C76B50] hover:text-[#C76B50] transition-colors shadow-sm"
          title="Download High-Res PNG App Icon"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>App Icon (PNG)</span>
        </a>
        <a
          href="#whatsapp-playbook"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold font-mono bg-[#10B981]/10 text-[#059669] border border-[#10B981]/30 hover:bg-[#10B981] hover:text-white transition-all shadow-sm"
        >
          <span class="w-2 h-2 rounded-full bg-[#10B981]"></span>
          <span>WhatsApp Playbook (14) &darr;</span>
        </a>
      </div>
    </header>

    <!-- Interactive Brand Kit Showcase Island -->
    <BrandKitViewer client:load />

    <!-- Legal & Trademark Notice -->
    <section class="mt-20 pt-10 border-t border-[#1F1F23]/8 max-w-4xl mx-auto text-center font-body text-xs text-[#8C847B] space-y-2">
      <p>
        The NextReach Studio logotype, geometric arrow monogram, and associated visual assets are proprietary trademarks of NextReach Studio.
      </p>
      <p>
        For press inquiries, sponsorship agreements, or custom partnership co-branding permissions, please contact our team via <a href="/contact" class="text-[#C76B50] underline hover:text-[#D97A5E]">studio contact</a> or email <code class="font-mono text-[11px] text-[#1F1F23] bg-[#F0ECE4] px-1.5 py-0.5 rounded">team@nextreachstudio.com</code>.
      </p>
    </section>
  </main>

  <Footer />
</Layout>
