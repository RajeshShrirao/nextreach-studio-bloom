---
import ServiceLayout from "@/components/ServiceLayout.astro";
---

<ServiceLayout
  title="Website Development Pune | Senior Web Engineering Studio"
  description="Custom website design and development in Pune. Built with Astro and Next.js by a senior engineer. Fixed-scope investment from ₹15,000 to ₹60,000. Verified 100/100 Core Web Vitals."
  serviceTag="Pune Website Engineering"
  cityName="Pune"
  priceCurrency="INR"
  headline="High-performance business websites, built in Pune by a senior engineer."
  subheadline="We design and build production-ready custom websites for Pune businesses across Baner, Hinjewadi, Kharadi, Kothrud, and Bhosari. Fixed scope, sub-second speed, zero junior handoffs."
  offerings={[
    {
      title: "Commercial Business Websites",
      description: "Fast, bespoke websites for Pune B2B firms, consulting agencies, healthcare clinics, and real estate developers. Clean Astro architecture with zero WordPress maintenance vulnerabilities."
    },
    {
      title: "Chakan & Bhosari Industrial Catalogues",
      description: "Detailed engineering specifications, downloadable drawings, and automated RFQ pipelines for Pune automotive suppliers and precision manufacturing exporters."
    },
    {
      title: "Hinjewadi & Kharadi Tech Landing Pages",
      description: "High-conversion marketing websites, interactive product tours, and case study hubs designed for Pune SaaS startups and IT service firms."
    },
    {
      title: "Local Pune SEO & Map Pack Leadership",
      description: "Complete structured JSON-LD schema (Service, LocalBusiness, FAQ), locality entity targeting, and sub-second page performance to dominate local Pune search queries."
    },
    {
      title: "Fixed-Scope Fast Turnaround Packages",
      description: "Fixed-scope websites launching in 3 to 7 days from ₹5,000 to ₹10,000 for Pune businesses needing an immediate, high-credibility digital presence without agency bloat."
    }
  ]}
  idealClient="Pune business owners, Hinjewadi tech startups, Bhosari manufacturers, and professional services wanting direct senior engineer delivery"
  timeline="3 days - 4 weeks"
  priceRange="₹15,000 - ₹60,000"
  relatedLinks={[
    { href: "/services/website-development-mumbai", label: "Website Development Mumbai" },
    { href: "/services/website-development-nagpur", label: "Website Development Nagpur" },
    { href: "/services/website-development-nashik", label: "Website Development Nashik" },
    { href: "/services/website-development-chhatrapati-sambhajinagar", label: "Website Development Sambhajinagar" },
    { href: "/services/website-development-kolhapur", label: "Website Development Kolhapur" },
    { href: "/fast-websites", label: "Fast Website Packages" }
  ]}
  researchLinks={[
    {
      href: "/blog/website-design-cost-pune-2026",
      label: "Website Design Cost in Pune (2026 Breakdown)",
      note: "Tier-by-tier market pricing, what AI genuinely cut, and why cheap ₹9,999 agency packages cost 4x more later."
    },
    {
      href: "/blog/website-speed-core-web-vitals-pune",
      label: "Core Web Vitals for Pune Businesses",
      note: "52% of page-one Pune Google results fail mobile Core Web Vitals. How static compilation solves it."
    },
    {
      href: "/blog/web-design-company-pune-how-to-choose",
      label: "How to Choose a Web Design Company in Pune",
      note: "12 questions that separate senior engineers from template resellers, plus 6 red flags."
    },
    {
      href: "/blog/custom-website-vs-wordpress-pune",
      label: "Custom Website vs WordPress in Pune",
      note: "The total cost of ownership comparison: security patches, plugin bloat, and annual maintenance."
    }
  ]}
  portfolioTags={["corporate", "industrial", "Pune", "web engineering"]}
>
  <!-- Pune Locality & Transparent Pricing Panel -->
  <section class="max-w-4xl mx-auto px-4 mb-16" aria-label="Why Pune Businesses Choose NextReach Studio">
    <div class="rounded-2xl p-6 sm:p-8 bg-[#FAF8F5] border border-[#1F1F23]/10 shadow-sm">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-2 h-2 rounded-full bg-[#C76B50]"></span>
        <span class="text-xs font-mono uppercase tracking-wider text-[#C76B50] font-semibold">The Studio Standard</span>
      </div>
      <h3 class="font-display font-bold text-xl sm:text-2xl text-[#1F1F23] mb-4">
        Direct Engineering Delivery on Fixed Scope
      </h3>
      <p class="text-xs sm:text-sm text-[#56564F] leading-relaxed mb-6 font-body">
        NextReach Studio is an independent software studio based in Pune. You never speak to an account executive or sales representative who disappears after signing the contract. You talk directly with principal engineer Rajesh Shrirao. Every website is built on Astro 6 and Tailwind v4, scores 100/100 on Google Lighthouse, and is handed over with complete source code ownership.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-[#1F1F23]/8">
        <div>
          <div class="text-lg font-bold font-display text-[#1F1F23] mb-1">Fixed-Scope Clarity</div>
          <div class="text-xs text-[#6E6862]">One agreed price before we start. No unexpected scope creep invoices.</div>
        </div>
        <div>
          <div class="text-lg font-bold font-display text-[#1F1F23] mb-1">100/100 Core Web Vitals</div>
          <div class="text-xs text-[#6E6862]">Sub-second loading times on mobile devices across 4G and 5G networks.</div>
        </div>
        <div>
          <div class="text-lg font-bold font-display text-[#1F1F23] mb-1">Full Source Handover</div>
          <div class="text-xs text-[#6E6862]">You own your GitHub repository, hosting credentials, and domain.</div>
        </div>
      </div>
    </div>
  </section>
</ServiceLayout>
