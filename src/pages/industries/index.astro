---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
  title="Industries We Serve — Software & AI by Sector"
  description="Industry-specific software and AI solutions for manufacturing, logistics, education, real estate, healthcare, retail, restaurants, construction, and pet grooming businesses in Pune."
>
  <Nav />
  <main class="container-page-wide relative">
    <div class="absolute top-0 left-1/4 -translate-y-12 w-[600px] h-[350px] bg-[#c76b50]/8 rounded-full blur-[120px] pointer-events-none -z-10" aria-hidden="true"></div>

    <header class="header-page stagger-parent max-w-4xl mx-auto px-4 text-center">
      <p class="header-page-pretitle inline-block">Industries</p>
      <h1 class="header-page-title">Solutions built for your industry</h1>
      <p class="header-page-subtitle mx-auto font-body">
        We tailor custom software and AI automation to the specific workflows, regulations, and challenges of each sector we serve.
      </p>
    </header>

    <div class="max-w-4xl mx-auto px-4 mb-16 space-y-6 stagger-parent">
      <div class="card-studio">
        <div class="flex flex-col md:flex-row md:items-start gap-6">
          <div class="icon-glow-wrapper shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
            </svg>
          </div>
          <div class="flex-1 space-y-4">
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-white font-display mb-1.5">Manufacturing</h2>
              <p class="text-xs sm:text-sm text-[#a69d92] leading-relaxed font-body">
                Production tracking, inventory management, quality control dashboards, and supply chain automation for Pune factories and fabrication shops.
              </p>
            </div>
            <div class="pt-2">
              <a href="/industries/manufacturing" class="text-xs text-[#c76b50] hover:text-[#d97a5e] font-semibold transition-colors font-mono">Learn more →</a>
            </div>
          </div>
        </div>
      </div>

      <div class="card-studio">
        <div class="flex flex-col md:flex-row md:items-start gap-6">
          <div class="icon-glow-wrapper shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
          </div>
          <div class="flex-1 space-y-4">
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-white font-display mb-1.5">Logistics &amp; Transportation</h2>
              <p class="text-xs sm:text-sm text-[#a69d92] leading-relaxed font-body">
                Fleet management, route optimization, delivery tracking, billing automation, and client portals for Pune logistics operators.
              </p>
            </div>
            <div class="pt-2">
              <a href="/industries/logistics" class="text-xs text-[#c76b50] hover:text-[#d97a5e] font-semibold transition-colors font-mono">Learn more →</a>
            </div>
          </div>
        </div>
      </div>

      <div class="card-studio">
        <div class="flex flex-col md:flex-row md:items-start gap-6">
          <div class="icon-glow-wrapper shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
            </svg>
          </div>
          <div class="flex-1 space-y-4">
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-white font-display mb-1.5">Education &amp; EdTech</h2>
              <p class="text-xs sm:text-sm text-[#a69d92] leading-relaxed font-body">
                Learning management systems, student portals, attendance tracking, exam platforms, and administration dashboards for Pune educational institutions.
              </p>
            </div>
            <div class="pt-2">
              <a href="/industries/education" class="text-xs text-[#c76b50] hover:text-[#d97a5e] font-semibold transition-colors font-mono">Learn more →</a>
            </div>
          </div>
        </div>
      </div>

      <div class="card-studio">
        <div class="flex flex-col md:flex-row md:items-start gap-6">
          <div class="icon-glow-wrapper shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <div class="flex-1 space-y-4">
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-white font-display mb-1.5">Real Estate &amp; Property</h2>
              <p class="text-xs sm:text-sm text-[#a69d92] leading-relaxed font-body">
                Property listing platforms, tenant portals, maintenance ticketing, lease management, and CRM for Pune real estate agencies and developers.
              </p>
            </div>
            <div class="pt-2">
              <a href="/industries/real-estate" class="text-xs text-[#c76b50] hover:text-[#d97a5e] font-semibold transition-colors font-mono">Learn more →</a>
            </div>
          </div>
        </div>
      </div>

      <div class="card-studio">
        <div class="flex flex-col md:flex-row md:items-start gap-6">
          <div class="icon-glow-wrapper shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
            </svg>
          </div>
          <div class="flex-1 space-y-4">
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-white font-display mb-1.5">Healthcare &amp; Wellness</h2>
              <p class="text-xs sm:text-sm text-[#a69d92] leading-relaxed font-body">
                Patient management, appointment scheduling, EHR portals, billing systems, and clinic analytics for Pune healthcare providers.
              </p>
            </div>
            <div class="pt-2">
              <a href="/industries/healthcare" class="text-xs text-[#c76b50] hover:text-[#d97a5e] font-semibold transition-colors font-mono">Learn more →</a>
            </div>
          </div>
        </div>
      </div>

      <div class="card-studio">
        <div class="flex flex-col md:flex-row md:items-start gap-6">
          <div class="icon-glow-wrapper shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
          </div>
          <div class="flex-1 space-y-4">
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-white font-display mb-1.5">Retail &amp; E‑Commerce</h2>
              <p class="text-xs sm:text-sm text-[#a69d92] leading-relaxed font-body">
                Inventory management, POS integration, supplier portals, order tracking, and customer loyalty systems for Pune retailers.
              </p>
            </div>
            <div class="pt-2">
              <a href="/industries/retail" class="text-xs text-[#c76b50] hover:text-[#d97a5e] font-semibold transition-colors font-mono">Learn more →</a>
            </div>
          </div>
        </div>
      </div>

      <div class="card-studio">
        <div class="flex flex-col md:flex-row md:items-start gap-6">
          <div class="icon-glow-wrapper shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/>
            </svg>
          </div>
          <div class="flex-1 space-y-4">
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-white font-display mb-1.5">Restaurants &amp; Food Services</h2>
              <p class="text-xs sm:text-sm text-[#a69d92] leading-relaxed font-body">
                Order management, menu digitization, delivery tracking, inventory, staff scheduling, and customer engagement for Pune restaurants.
              </p>
            </div>
            <div class="pt-2">
              <a href="/industries/restaurants" class="text-xs text-[#c76b50] hover:text-[#d97a5e] font-semibold transition-colors font-mono">Learn more →</a>
            </div>
          </div>
        </div>
      </div>

      <div class="card-studio">
        <div class="flex flex-col md:flex-row md:items-start gap-6">
          <div class="icon-glow-wrapper shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 22L16 8"/><path d="M21 2L17 6"/><path d="M17 16l4-4"/><path d="M3 10l4 4"/>
            </svg>
          </div>
          <div class="flex-1 space-y-4">
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-white font-display mb-1.5">Construction &amp; Contracting</h2>
              <p class="text-xs sm:text-sm text-[#a69d92] leading-relaxed font-body">
                Project tracking, site management, contractor portals, material procurement, and compliance reporting for Pune construction firms.
              </p>
            </div>
            <div class="pt-2">
              <a href="/industries/construction" class="text-xs text-[#c76b50] hover:text-[#d97a5e] font-semibold transition-colors font-mono">Learn more →</a>
            </div>
          </div>
        </div>
      </div>

      <div class="card-studio">
        <div class="flex flex-col md:flex-row md:items-start gap-6">
          <div class="icon-glow-wrapper shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
            </svg>
          </div>
          <div class="flex-1 space-y-4">
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-white font-display mb-1.5">Pet Grooming &amp; Animal Care</h2>
              <p class="text-xs sm:text-sm text-[#a69d92] leading-relaxed font-body">
                Appointment booking, client management, pet profiles, loyalty programs, and automated reminders for Pune pet grooming businesses.
              </p>
            </div>
            <div class="pt-2">
              <a href="/industries/pet-grooming" class="text-xs text-[#c76b50] hover:text-[#d97a5e] font-semibold transition-colors font-mono">Learn more →</a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>
  <Footer />
</Layout>
