---
import ServiceLayout from "@/components/ServiceLayout.astro";
---

<ServiceLayout
  title="Software for Restaurants & Cafes Pune"
  description="Custom software for Pune restaurants - online ordering, table booking, POS, kitchen display systems, and customer loyalty platforms."
  serviceTag="Restaurants"
  headline="Restaurant technology that serves you better."
  subheadline="We build custom restaurant management software for Pune eateries - online ordering, table reservations, POS systems, and kitchen management."
  offerings={[
    { title: "Online Ordering & Delivery", description: "Website and app ordering with payment processing, and real-time delivery tracking." },
    { title: "Table Booking System", description: "Online reservations, table management, waitlist handling, and automated confirmations." },
    { title: "POS & Billing", description: "Order entry, split bills, multiple payment options, and detailed sales reports." },
    { title: "Kitchen Display System", description: "Order routing to kitchen stations, prep tracking, and timing alerts for consistent service." },
    { title: "Customer Loyalty & Marketing", description: "Rewards programs, targeted offers, and automated SMS or WhatsApp campaigns." },
  ]}
  idealClient="Pune restaurants, cloud kitchens, cafes, and catering businesses"
  timeline="3-6 weeks"
  priceRange="$2,000-$5,000"
  relatedLinks={[
    { href: "https://saffron-and-smoke-sigma.vercel.app", label: "Live Demo: Saffron & Smoke" },
    { href: "/demos/saffron-and-smoke/", label: "Case Dossier: Saffron & Smoke" },
    { href: "/services/flutter-app-development-pune/", label: "Flutter App Development" },
    { href: "/services/android-app-development-pune/", label: "Android App Development" },
    { href: "/services/business-automation-pune/", label: "Business Automation Services" },
    { href: "/services/", label: "All Services" },
    { href: "/portfolio/", label: "View Our Portfolio" },
  ]}
  researchLinks={[
    { href: "/blog/responsive-web-design-pune/", label: "Responsive Web Design in 2026: What Pune Businesses Actually Need", note: "India runs ~80% mobile. How to audit and fix yours." },
    { href: "/blog/landing-page-design-conversion/", label: "Landing Page Design in 2026: What Actually Converts for Indian Businesses", note: "The structure that converts, and what silently loses leads." },
    { href: "/blog/website-design-pune-sme-priorities/", label: "Website Design for Pune SMEs: What Actually Moves the Needle in 2026", note: "The 10 improvements that actually move leads, ranked by impact." },
    { href: "/blog/website-design-cost-pune-2026/", label: "Website Design Cost in Pune 2026: What AI Changed About Pricing", note: "What Pune quotes actually buy, tier by tier, and what AI genuinely cut." }
  ]}
  portfolioTags={["restaurants", "mobile", "POS"]}
>
  <!-- Live Showcase Card for Restaurant Owners -->
  <div class="max-w-4xl mx-auto px-4 mb-16">
    <div class="card-studio-accent p-6 sm:p-8 border border-[#C76B50]/30 bg-gradient-to-br from-white via-white to-[#C76B50]/8 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md text-[10px] font-mono font-semibold bg-[#C76B50]/10 border border-[#C76B50]/25 text-[#C76B50]">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          Live Production Proof
        </span>
        <span class="text-xs font-mono text-[#6E6862]">Baner, Pune</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
        <div class="md:col-span-7">
          <h3 class="text-xl sm:text-2xl font-serif text-[#1F1F23] mb-2 font-bold">
            Saffron &amp; Smoke - Modern Indian Dining
          </h3>
          <p class="text-xs sm:text-sm text-[#6E6862] leading-relaxed font-body mb-5 font-normal">
            Test a live, interactive restaurant flagship featuring multi-sitting table reservations with custom booking references, instant WhatsApp concierge routing, and Architectural Digest India editorial design.
          </p>

          <div class="flex flex-wrap items-center gap-3">
            <a
              href="https://saffron-and-smoke-sigma.vercel.app"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-xl text-xs font-display font-semibold uppercase tracking-wider bg-[#C76B50] hover:bg-[#D97A5E] text-white shadow-[0_4px_16px_rgba(199,107,80,0.25)] transition-all font-mono"
            >
              Test Live Restaurant Demo ↗
            </a>
            <a
              href="/demos/saffron-and-smoke/"
              class="px-4 py-2 rounded-xl text-xs font-mono text-[#1F1F23] hover:text-[#C76B50] border border-[#1F1F23]/10 bg-[#FAF8F5] hover:bg-white transition-colors shadow-sm"
            >
              Read Case Dossier →
            </a>
          </div>
        </div>

        <div class="md:col-span-5">
          <div class="aspect-video rounded-xl overflow-hidden border border-[#1F1F23]/10 shadow-xl">
            <img
              src="/assets/demos/saffron-and-smoke/hero-dish.jpg"
              alt="Saffron & Smoke restaurant demo"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</ServiceLayout>
