---
import Layout from "@/layouts/Layout.astro";
import ReachBackground from "@/components/reach/ReachBackground";
import ReachNav from "@/components/reach/ReachNav";
import ReachHero from "@/components/reach/ReachHero";
import ReachProblem from "@/components/reach/ReachProblem";
import ReachOutcome from "@/components/reach/ReachOutcome";
import ReachWork from "@/components/reach/ReachWork";
import ReachSystem from "@/components/reach/ReachSystem";
import ReachServices from "@/components/reach/ReachServices";
import ReachProcess from "@/components/reach/ReachProcess";
import ReachPricing from "@/components/reach/ReachPricing";
import ReachPsychology from "@/components/reach/ReachPsychology";
import ReachWhy from "@/components/reach/ReachWhy";
import ReachFaq, { FAQS } from "@/components/reach/ReachFaq";
import ReachFinalCta from "@/components/reach/ReachFinalCta";
import ReachFooter from "@/components/reach/ReachFooter";

const pageTitle = "NextReach Studio | Websites That Move Businesses Forward";
const pageDescription = "NextReach Studio creates premium, conversion-focused websites for ambitious small businesses and startups. Fixed-scope packages from ₹5,000 with 1 to 3 days turnaround, local SEO foundations, and WhatsApp conversion.";

const servicesSchema = [
  { name: "Web Design", description: "Premium bespoke interfaces designed around your business positioning." },
  { name: "Development", description: "Fast, responsive, production-ready websites built on Astro and modern static architecture." },
  { name: "SEO Foundation", description: "Schema.org structured data, local map pack signals, and AI search indexing." },
  { name: "WhatsApp Conversion", description: "Turn visitors into paying conversations with 1-click lead routing." },
  { name: "Analytics", description: "Privacy-first event tracking and commercial attribution." },
];
---

<Layout 
  localFonts 
  skipLoader 
  title={pageTitle} 
  description={pageDescription}
>
  <div class="reach-dark-studio" data-reach-home>
    {/* Monochromatic Grain and Radial Lighting Overlay */}
    <ReachBackground client:idle />

    {/* Floating Minimalist Navigation */}
    <ReachNav client:load />

    {/* Main Content Sections */}
    <main id="main-content" tabindex="-1">
      {/* 01: Master Cinematic Hero + 3D Multi-Depth Browser */}
      <ReachHero client:load />

      {/* 02: The Problem */}
      <ReachProblem client:visible />

      {/* 03: The Conversion Outcome (Search -> Land -> Trust -> Message -> Customer) */}
      <ReachOutcome client:visible />

      {/* 04: Selected Concept Work / Portfolio */}
      <ReachWork client:visible />

      {/* 05: The Signature "NextReach" Orbital System */}
      <ReachSystem client:visible />

      {/* 06: Core Capabilities (Everything Your Digital Front Door Needs) */}
      <ReachServices client:visible />

      {/* 07: Process & Interactive 3-Day Sprint Timeline */}
      <ReachProcess client:visible />

      {/* 08: Transparent Pricing Tiers (₹5,000 / ₹7,500 / ₹10,000) */}
      <ReachPricing client:visible />

      {/* 09: Typographic Pricing Psychology */}
      <ReachPsychology client:visible />

      {/* 10: Studio Principles (Small Team. Big Digital Energy.) */}
      <ReachWhy client:visible />

      {/* 11: Frequently Asked Questions Accordion */}
      <ReachFaq client:visible />

      {/* 12: Massive Final Call to Action */}
      <ReachFinalCta client:visible />
    </main>

    {/* Footer */}
    <ReachFooter client:visible />
  </div>

  {/* Structured Data: Service ItemList for Google */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "NextReach Studio Services",
    "itemListElement": servicesSchema.map((item, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Service",
        "name": item.name,
        "description": item.description,
        "provider": {
          "@type": "ProfessionalService",
          "name": "NextReach Studio",
          "url": "https://www.nextreachstudio.in"
        }
      }
    }))
  })} />

  {/* Structured Data: FAQPage for AI search engines & Google Rich Results */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": FAQS.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  })} />
</Layout>
