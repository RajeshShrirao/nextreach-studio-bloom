---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import HeroSection from "@/components/hero/HeroSection";
import LogoMarquee from "@/components/brand/LogoMarquee.astro";
import TestimonialWall from "@/components/brand/TestimonialWall.astro";
import BentoGrid from "@/components/BentoGrid.astro";
import PricingPackages from "@/components/PricingPackages.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

let latestGuides: any[] = [];
try {
  const guides = await getCollection("guides", ({ data }) => !data.draft);
  latestGuides = guides
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .slice(0, 3);
} catch {}
---

<Layout
  title="Custom Websites, Web Apps & AI Workflows | NextReach Studio"
  description="NextReach Studio engineers high-performance custom websites, web applications, and autonomous AI workflows in 24 to 72 hours. Fixed-scope sprint packages starting at ₹5,000. Direct senior developer access."
>
  <!-- Structured Data: Services offered -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "Service",
          "name": "High-Velocity Custom Website Packages",
          "description": "Bespoke custom-designed websites starting at ₹5,000 shipped in 24-72 hours under fixed-scope contracts."
        }
      },
      {
        "@type": "ListItem",
        "position": 2,
        "item": {
          "@type": "Service",
          "name": "Custom Web Applications & SaaS",
          "description": "Multi-tenant platforms, client portals, admin panels, and operational dashboards built with modern full-stack frameworks."
        }
      },
      {
        "@type": "ListItem",
        "position": 3,
        "item": {
          "@type": "Service",
          "name": "Autonomous AI Agent Development",
          "description": "Custom AI agents for customer support, sales pipelines, and multi-agent systems with MCP integration."
        }
      },
      {
        "@type": "ListItem",
        "position": 4,
        "item": {
          "@type": "Service",
          "name": "Business Process Automation",
          "description": "Invoicing, inventory, CRM, WhatsApp, and document processing automation using Python and AI workflows."
        }
      },
      {
        "@type": "ListItem",
        "position": 5,
        "item": {
          "@type": "Service",
          "name": "Rapid MVP Engineering",
          "description": "Functional products with auth, payments, and database shipped in 4-6 week sprint cycles."
        }
      }
    ]
  })} />
  <Nav />

  <main>
    <HeroSection client:load />

    <LogoMarquee />

    <PricingPackages />

    <!-- ==================== FEATURED LIVE DEMO: SAFFRON & SMOKE ==================== -->
    <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-[#1F1F23]/8" id="live-demo" aria-labelledby="demo-heading">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <div class="lg:col-span-5">
          <p class="text-xs font-mono font-bold uppercase tracking-[0.24em] text-[#C76B50] mb-3">
            Featured Production Demo
          </p>
          <h2 id="demo-heading" class="text-2xl sm:text-4xl font-display font-bold text-[#1F1F23] tracking-[-0.03em] leading-tight mb-4">
            Saffron &amp; Smoke<br />
            <span class="text-[#C76B50]">Luxury Modern Indian Dining</span>
          </h2>
          <p class="text-[#6E6862] text-sm sm:text-base leading-relaxed font-body mb-6">
            We don't pitch static Figma files. Below is an active production restaurant platform engineered for an upscale dining atelier in Baner, Pune. Features real-time multi-sitting reservations, automated booking codes, WhatsApp concierge routing, and Architectural Digest India editorial aesthetics.
          </p>

          <div class="space-y-3 mb-8">
            <div class="flex items-center gap-3 text-xs sm:text-sm text-[#4A4844] font-body">
              <span class="text-[#C76B50] font-bold text-sm shrink-0">✓</span>
              Multi-sitting reservation engine with automated guest confirmation codes
            </div>
            <div class="flex items-center gap-3 text-xs sm:text-sm text-[#4A4844] font-body">
              <span class="text-[#C76B50] font-bold text-sm shrink-0">✓</span>
              Filterable 4-course and 7-course tasting menu drawer with culinary pairing notes
            </div>
            <div class="flex items-center gap-3 text-xs sm:text-sm text-[#4A4844] font-body">
              <span class="text-[#C76B50] font-bold text-sm shrink-0">✓</span>
              Sub-second mobile rendering with chiaroscuro side lighting aesthetics
            </div>
          </div>

          <div class="flex flex-col sm:flex-row flex-wrap items-center gap-3">
            <a
              href="https://saffron-and-smoke-sigma.vercel.app"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto text-center px-5 py-3 rounded-xl bg-[#C76B50] hover:bg-[#D97A5E] text-white font-display font-semibold text-xs sm:text-sm shadow-[0_4px_16px_rgba(199,107,80,0.22)] transition-all duration-200 hover:-translate-y-0.5"
            >
              <span>Launch Live Demo ↗</span>
            </a>
            <a 
              href="https://wa.me/919822379976?text=Hi%20NextReach%20Studio%2C%20I%20saw%20the%20Saffron%20%26%20Smoke%20demo%20and%20want%20a%20similar%20Premium%20Flagship%20website%20(%E2%82%B910%2C000)%20for%20my%20business."
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto text-center px-4 py-3 rounded-xl bg-white hover:bg-[#FAF8F5] text-[#1F1F23] border border-[#1F1F23]/12 text-xs font-mono transition-all duration-200 flex items-center justify-center gap-1.5 shadow-sm hover:-translate-y-0.5"
            >
              <span>Order on WhatsApp (₹10k)</span>
            </a>
            <a href="/demos/saffron-and-smoke" class="text-xs text-[#6E6862] hover:text-[#1F1F23] transition-colors font-mono py-2">
              View Case Dossier &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-7">
          <div class="rounded-2xl border border-[#1F1F23]/10 bg-white p-3 sm:p-4 shadow-xl transition-all duration-300 hover:border-[#C76B50]/40">
            <div class="flex items-center justify-between px-2 pb-3 mb-1 border-b border-[#1F1F23]/8">
              <span class="text-[11px] font-mono font-semibold text-[#C76B50]">
                Premium Flagship Demo • ₹10,000 Package
              </span>
              <span class="text-[11px] font-mono text-[#6E6862]">
                Baner, Pune
              </span>
            </div>

            <div class="relative aspect-video rounded-xl overflow-hidden group">
              <img
                src="/assets/demos/saffron-and-smoke/hero-dish.jpg"
                alt="Saffron & Smoke - Modern Indian Restaurant in Baner, Pune"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                width="1280"
                height="720"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent"></div>

              <div class="absolute bottom-3 left-4 right-4 flex items-end justify-between">
                <div>
                  <p class="text-xs font-mono text-[#C76B50] uppercase tracking-widest">Saffron &amp; Smoke</p>
                  <p class="text-sm sm:text-base font-serif text-white font-medium">"India, on a different plate."</p>
                </div>
                <a
                  href="https://saffron-and-smoke-sigma.vercel.app"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-3 py-1.5 rounded-lg text-xs font-mono font-semibold bg-[#C76B50] text-white hover:bg-[#D97A5E] transition-colors shadow-md"
                >
                  Visit Demo ↗
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== BESPOKE SYSTEMS BENTO GRID ==================== -->
    <BentoGrid />

    <!-- ==================== PROCESS TIMELINE ==================== -->
    <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-[#1F1F23]/8" id="process" aria-labelledby="process-heading">
      <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-16">
        <p class="text-xs uppercase tracking-[0.24em] text-[#C76B50] mb-2 font-bold font-mono">Workflow</p>
        <h2 id="process-heading" class="text-2xl sm:text-4xl font-display font-bold text-[#1F1F23] tracking-[-0.03em] leading-tight">
          From discovery to handover in 5 clear stages
        </h2>
        <p class="text-[#6E6862] text-sm sm:text-base mt-3 font-body leading-relaxed">
          Transparent milestones. Fixed pricing. Guaranteed code and asset ownership.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-3 md:gap-4">
        <div class="flex items-start gap-3 md:flex-col md:items-center md:text-center p-4 rounded-xl bg-white border border-[#1F1F23]/8 shadow-sm transition-all hover:border-[#C76B50]/30 hover:shadow-md">
          <div class="timeline-node shrink-0">01</div>
          <div class="md:mt-2">
            <p class="text-xs font-bold text-[#C76B50] uppercase tracking-wider font-mono mb-1">Discovery</p>
            <p class="text-xs text-[#6E6862] leading-relaxed font-body">Your business problem, technical constraints, and target conversion metrics.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 md:flex-col md:items-center md:text-center p-4 rounded-xl bg-white border border-[#1F1F23]/8 shadow-sm transition-all hover:border-[#C76B50]/30 hover:shadow-md">
          <div class="timeline-node shrink-0">02</div>
          <div class="md:mt-2">
            <p class="text-xs font-bold text-[#C76B50] uppercase tracking-wider font-mono mb-1">Proposal</p>
            <p class="text-xs text-[#6E6862] leading-relaxed font-body">Written deliverables breakdown, exact delivery date, and one-time fixed price.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 md:flex-col md:items-center md:text-center p-4 rounded-xl bg-white border border-[#C76B50]/40 shadow-md">
          <div class="timeline-node timeline-node--active shrink-0">03</div>
          <div class="md:mt-2">
            <p class="text-xs font-bold text-[#C76B50] uppercase tracking-wider font-mono mb-1">Sprint Build</p>
            <p class="text-xs text-[#6E6862] leading-relaxed font-body">Fast-paced development with live staging URLs and senior developer access.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 md:flex-col md:items-center md:text-center p-4 rounded-xl bg-white border border-[#1F1F23]/8 shadow-sm transition-all hover:border-[#C76B50]/30 hover:shadow-md">
          <div class="timeline-node shrink-0">04</div>
          <div class="md:mt-2">
            <p class="text-xs font-bold text-[#C76B50] uppercase tracking-wider font-mono mb-1">QA &amp; Speed</p>
            <p class="text-xs text-[#6E6862] leading-relaxed font-body">Cross-device responsiveness, Core Web Vitals checks, and security review.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 md:flex-col md:items-center md:text-center p-4 rounded-xl bg-white border border-[#1F1F23]/8 shadow-sm transition-all hover:border-[#C76B50]/30 hover:shadow-md">
          <div class="timeline-node shrink-0">05</div>
          <div class="md:mt-2">
            <p class="text-xs font-bold text-[#C76B50] uppercase tracking-wider font-mono mb-1">Handover</p>
            <p class="text-xs text-[#6E6862] leading-relaxed font-body">Full Git repository, database credentials, documentation, and support.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== WHY NEXTREACH ==================== -->
    <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-[#1F1F23]/8" id="why-us" aria-labelledby="why-heading">
      <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-16">
        <p class="text-xs uppercase tracking-[0.24em] text-[#C76B50] mb-2 font-bold font-mono">Why NextReach Studio</p>
        <h2 id="why-heading" class="text-2xl sm:text-4xl font-display font-bold text-[#1F1F23] tracking-[-0.03em] leading-tight">
          Senior engineering discipline.<br />Startup speed and fixed pricing.
        </h2>
        <p class="text-[#6E6862] text-sm sm:text-base mt-3 font-body">
          Why ambitious businesses and founders partner directly with our senior developers.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 max-w-5xl mx-auto">
        <div class="comparison-card comparison-card--negative">
          <div class="flex items-center gap-2 mb-4">
            <svg class="w-4 h-4 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            <h3 class="text-sm font-bold text-[#1F1F23] font-display">Traditional Agency Model</h3>
          </div>
          <ul class="space-y-3">
            <li class="flex gap-2.5 text-xs text-[#6E6862]"><span class="text-red-500 shrink-0 mt-0.5">✕</span>Account managers who relay messages between you and developers</li>
            <li class="flex gap-2.5 text-xs text-[#6E6862]"><span class="text-red-500 shrink-0 mt-0.5">✕</span>Weekly status meetings that substitute for actual code progress</li>
            <li class="flex gap-2.5 text-xs text-[#6E6862]"><span class="text-red-500 shrink-0 mt-0.5">✕</span>Inflated hourly retainers that incentivize slow delivery</li>
            <li class="flex gap-2.5 text-xs text-[#6E6862]"><span class="text-red-500 shrink-0 mt-0.5">✕</span>"We will scope it during the project" leading to surprise overruns</li>
          </ul>
        </div>

        <div class="comparison-card comparison-card--positive border-[#C76B50]/30 shadow-md">
          <div class="flex items-center gap-2 mb-4">
            <svg class="w-4 h-4 text-[#C76B50]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            <h3 class="text-sm font-bold text-[#C76B50] font-display">The NextReach Model</h3>
          </div>
          <ul class="space-y-3">
            <li class="flex gap-2.5 text-xs text-[#4A4844]"><span class="text-emerald-600 shrink-0 mt-0.5 font-bold">✓</span>Direct access to the senior engineer building your system</li>
            <li class="flex gap-2.5 text-xs text-[#4A4844]"><span class="text-emerald-600 shrink-0 mt-0.5 font-bold">✓</span>Fixed, transparent milestones with a written technical scope</li>
            <li class="flex gap-2.5 text-xs text-[#4A4844]"><span class="text-emerald-600 shrink-0 mt-0.5 font-bold">✓</span>Fast production sprints with live staging links and walkthroughs</li>
            <li class="flex gap-2.5 text-xs text-[#4A4844]"><span class="text-emerald-600 shrink-0 mt-0.5 font-bold">✓</span>One-time project pricing. You own 100% of the finished product.</li>
          </ul>
        </div>
      </div>

      <div class="text-center mt-12">
        <p class="text-[#6E6862] text-sm sm:text-base mb-6 font-body">
          Ready to launch your project?
        </p>
        <a href="/contact" class="btn-premium-primary">
          Schedule a Technical Discovery Call
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </section>

    <!-- ==================== WALL OF LOVE (TESTIMONIALS) ==================== -->
    <TestimonialWall />

    <!-- ==================== BLOG / RESOURCES FOOTER ==================== -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-[#1F1F23]/8" id="ai-dev-hub">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">
        <div>
          <p class="text-xs uppercase tracking-[0.18em] text-[#6E6862] mb-2 font-bold font-mono">Open Source &amp; Research</p>
          <h2 class="text-2xl sm:text-3xl font-display font-bold text-[#1F1F23] mb-4">
            Our Technical Depth
          </h2>
          <p class="text-[#6E6862] text-xs sm:text-sm leading-relaxed mb-6 font-body">
            We don't just build client applications. We engineer open-source MCP servers, token calculators, and publish technical guides for AI developers and founders.
          </p>
          <a href="/tools" class="inline-flex items-center gap-1.5 text-sm text-[#C76B50] hover:text-[#D97A5E] transition-colors font-semibold">
            <span>Explore our developer tools</span>
            <span>&rarr;</span>
          </a>
        </div>

        <div class="lg:col-span-2 space-y-4">
          <h3 class="text-xs font-bold text-[#6E6862] uppercase tracking-wider mb-2 font-mono">Latest from our Blog &amp; Guides</h3>

          <div class="space-y-3">
            {latestPosts.map((post) => (
              <a href={`/blog/${post.id}`} class="card-studio hover:border-[#C76B50]/40 flex justify-between items-center py-3.5 px-5 group shadow-sm">
                <div>
                  <span class="text-[10px] text-[#8C847B] mr-3 font-mono">{post.data.pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span>
                  <span class="text-xs sm:text-sm font-semibold text-[#1F1F23] group-hover:text-[#C76B50] transition-colors font-display">{post.data.title}</span>
                </div>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5 text-[#8C847B] group-hover:text-[#C76B50] transition-all duration-200 group-hover:translate-x-0.5 shrink-0 ml-2">
                  <path d="M9 18l6-6-6-6"/>
                </svg>
              </a>
            ))}

            {latestGuides.slice(0, 1).map((guide: any) => (
              <a href={`/guides/${guide.id}`} class="card-studio hover:border-[#C76B50]/40 flex justify-between items-center py-3.5 px-5 group shadow-sm">
                <div>
                  <span class="badge-premium-neutral text-[9px] mr-3 uppercase font-mono">{guide.data.difficulty}</span>
                  <span class="text-xs sm:text-sm font-semibold text-[#1F1F23] group-hover:text-[#C76B50] transition-colors font-display">{guide.data.title}</span>
                </div>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5 text-[#8C847B] group-hover:text-[#C76B50] transition-all duration-200 group-hover:translate-x-0.5 shrink-0 ml-2">
                  <path d="M9 18l6-6-6-6"/>
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
