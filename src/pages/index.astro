---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import HeroSection from "@/components/hero/HeroSection";
import BentoGrid from "@/components/BentoGrid.astro";
import PricingPackages from "@/components/PricingPackages.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

let latestGuides: any[] = [];
try {
  const guides = await getCollection("guides", ({ data }) => !data.draft);
  latestGuides = guides
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .slice(0, 3);
} catch {}
---

<Layout
  title="Custom Websites, AI Workflows & Digital Flagships | NextReach Studio"
  description="NextReach Studio engineers high-performance custom websites, web applications, and autonomous AI workflows in 24 to 72 hours. Fixed-scope sprint packages starting at ₹5,000. Direct senior developer access."
>
  <!-- Structured Data: Services offered -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "Service",
          "name": "High-Velocity Custom Website Packages",
          "description": "Bespoke custom-designed websites starting at ₹5,000 shipped in 24-72 hours under fixed-scope contracts."
        }
      },
      {
        "@type": "ListItem",
        "position": 2,
        "item": {
          "@type": "Service",
          "name": "AI Agent Development",
          "description": "Custom AI agents for customer support, sales, HR, and multi-agent systems with MCP integration."
        }
      },
      {
        "@type": "ListItem",
        "position": 3,
        "item": {
          "@type": "Service",
          "name": "AI Automation",
          "description": "CRM, email, WhatsApp, and document processing automation using AI workflows and Python."
        }
      },
      {
        "@type": "ListItem",
        "position": 4,
        "item": {
          "@type": "Service",
          "name": "Custom Web Applications & SaaS",
          "description": "SaaS platforms, customer portals, admin panels, and dashboards built with modern full-stack frameworks."
        }
      },
      {
        "@type": "ListItem",
        "position": 5,
        "item": {
          "@type": "Service",
          "name": "Rapid MVP Engineering",
          "description": "Functional products with auth, payments, and database — shipped in 4-6 week sprints."
        }
      }
    ]
  })} />
  <Nav />

  <main>
    <HeroSection client:load />

    <PricingPackages />

    <!-- ==================== FEATURED LIVE DEMO: SAFFRON & SMOKE ==================== -->
    <section class="py-16 sm:py-24 px-6 sm:px-8 max-w-7xl mx-auto border-t border-[#1F1F23]/8" id="live-demo" aria-labelledby="demo-heading">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-5 stagger-parent">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-[#C76B50]/10 border border-[#C76B50]/25 text-[#C76B50] mb-4 shadow-sm">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Featured Production Demo
          </div>
          <h2 id="demo-heading" class="text-heading font-display font-bold text-[#1F1F23] mb-4">
            Saffron &amp; Smoke<br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#1F1F23] via-[#C76B50] to-[#B8583D]">Luxury Modern Indian Dining</span>
          </h2>
          <p class="text-[#6E6862] text-sm sm:text-base leading-relaxed font-body mb-6">
            We don’t pitch static Figma files. Below is an active, live-deployed restaurant platform built for an upscale dining atelier in Baner, Pune. Features real-time table reservations, WhatsApp concierge integration, and Architectural Digest India editorial design.
          </p>

          <div class="space-y-3 mb-8">
            <div class="flex items-center gap-3 text-xs text-[#4A4844] font-body">
              <span class="w-5 h-5 rounded-full bg-[#C76B50]/15 border border-[#C76B50]/30 flex items-center justify-center text-[#C76B50] text-[10px] font-bold">✓</span>
              Interactive multi-sitting reservation engine with automated booking codes
            </div>
            <div class="flex items-center gap-3 text-xs text-[#4A4844] font-body">
              <span class="w-5 h-5 rounded-full bg-[#C76B50]/15 border border-[#C76B50]/30 flex items-center justify-center text-[#C76B50] text-[10px] font-bold">✓</span>
              Filterable 4-course &amp; 7-course tasting menu drawer with culinary tasting notes
            </div>
            <div class="flex items-center gap-3 text-xs text-[#4A4844] font-body">
              <span class="w-5 h-5 rounded-full bg-[#C76B50]/15 border border-[#C76B50]/30 flex items-center justify-center text-[#C76B50] text-[10px] font-bold">✓</span>
              Pure CSS/SVG animated steam effect with chiaroscuro side lighting
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <a
              href="https://saffron-and-smoke-sigma.vercel.app"
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 rounded-xl bg-[#C76B50] hover:bg-[#D97A5E] text-white font-display font-semibold text-xs shadow-[0_4px_16px_rgba(199,107,80,0.25)] transition-all duration-200"
            >
              <span>Launch Live Demo ↗</span>
            </a>
            <a 
              href="https://wa.me/919822379976?text=Hi%20NextReach%20Studio%2C%20I%20saw%20the%20Saffron%20%26%20Smoke%20demo%20and%20want%20a%20similar%20Premium%20Flagship%20website%20(%E2%82%B910%2C000)%20for%20my%20business."
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2.5 rounded-xl bg-white hover:bg-[#FAF8F5] text-[#1F1F23] border border-[#1F1F23]/12 text-xs font-mono transition-all duration-200 flex items-center gap-1.5 shadow-sm"
            >
              <span>Order on WhatsApp (₹10k)</span>
            </a>
            <a href="/demos/saffron-and-smoke" class="text-xs text-[#6E6862] hover:text-[#1F1F23] transition-colors font-mono">
              View Case Dossier &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-7">
          <div class="relative group rounded-2xl overflow-hidden border border-[#1F1F23]/10 bg-white p-2 shadow-2xl transition-all duration-300 hover:border-[#C76B50]/40">
            <div class="relative aspect-video rounded-xl overflow-hidden">
              <img
                src="/assets/demos/saffron-and-smoke/hero-dish.jpg"
                alt="Saffron & Smoke — Modern Indian Restaurant in Baner, Pune"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
              
              <div class="absolute top-4 left-4 flex items-center gap-2">
                <span class="px-2.5 py-1 rounded-md text-[10px] font-mono font-semibold bg-black/75 backdrop-blur-md text-[#C76B50] border border-[#C76B50]/30">
                  Premium Flagship Demo • ₹10,000 Package
                </span>
                <span class="px-2.5 py-1 rounded-md text-[10px] font-mono text-[#D1CBC1] bg-black/75 backdrop-blur-md border border-white/10">
                  Baner, Pune
                </span>
              </div>

              <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between">
                <div>
                  <p class="text-xs font-mono text-[#C76B50] uppercase tracking-widest">Saffron &amp; Smoke</p>
                  <p class="text-base sm:text-lg font-serif text-white font-medium">"India, on a different plate."</p>
                </div>
                <a
                  href="https://saffron-and-smoke-sigma.vercel.app"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-3.5 py-1.5 rounded-lg text-xs font-mono font-semibold bg-[#C76B50] text-white hover:bg-[#D97A5E] transition-colors shadow-md"
                >
                  Visit Demo ↗
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== BESPOKE SYSTEMS BENTO GRID ==================== -->
    <BentoGrid />

    <!-- ==================== PROCESS TIMELINE ==================== -->
    <section class="py-20 px-6 sm:px-8 max-w-7xl mx-auto border-t border-[#1F1F23]/8" id="process" aria-labelledby="process-heading">
      <div class="text-center max-w-3xl mx-auto mb-16 stagger-parent">
        <p class="text-xs uppercase tracking-[0.18em] text-[#C76B50] mb-2 font-bold font-mono">Workflow</p>
        <h2 id="process-heading" class="text-heading font-display font-bold text-[#1F1F23]">
          From discovery to handover in 5 clear steps
        </h2>
        <p class="text-[#6E6862] text-sm sm:text-base mt-3 font-body leading-relaxed">
          Transparent milestones. Fixed pricing. No ambiguity.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-3 md:gap-4 stagger-parent">
        <div class="flex items-start gap-3 md:flex-col md:items-center md:text-center">
          <div class="timeline-node shrink-0">01</div>
          <div class="md:mt-2">
            <p class="text-[10px] font-bold text-[#C76B50] uppercase tracking-[0.12em] font-mono mb-0.5">Discovery</p>
            <p class="text-xs text-[#6E6862] leading-relaxed font-body">Your business problem, constraints, and desired outcomes.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 md:flex-col md:items-center md:text-center">
          <div class="timeline-node shrink-0">02</div>
          <div class="md:mt-2">
            <p class="text-[10px] font-bold text-[#C76B50] uppercase tracking-[0.12em] font-mono mb-0.5">Proposal</p>
            <p class="text-xs text-[#6E6862] leading-relaxed font-body">Feature breakdown, timeline, and one-time fixed price.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 md:flex-col md:items-center md:text-center">
          <div class="timeline-node timeline-node--active shrink-0">03</div>
          <div class="md:mt-2">
            <p class="text-[10px] font-bold text-[#C76B50] uppercase tracking-[0.12em] font-mono mb-0.5">Development</p>
            <p class="text-xs text-[#6E6862] leading-relaxed font-body">Bi-weekly sprints with staging links and walkthroughs.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 md:flex-col md:items-center md:text-center">
          <div class="timeline-node shrink-0">04</div>
          <div class="md:mt-2">
            <p class="text-[10px] font-bold text-[#C76B50] uppercase tracking-[0.12em] font-mono mb-0.5">Testing &amp; QA</p>
            <p class="text-xs text-[#6E6862] leading-relaxed font-body">Functionality, responsiveness, and load time checks.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 md:flex-col md:items-center md:text-center">
          <div class="timeline-node shrink-0">05</div>
          <div class="md:mt-2">
            <p class="text-[10px] font-bold text-[#C76B50] uppercase tracking-[0.12em] font-mono mb-0.5">Handover</p>
            <p class="text-xs text-[#6E6862] leading-relaxed font-body">Full code, database, docs, and support period.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== WHY NEXTREACH ==================== -->
    <section class="py-20 px-6 sm:px-8 max-w-7xl mx-auto border-t border-[#1F1F23]/8" id="why-us" aria-labelledby="why-heading">
      <div class="text-center max-w-3xl mx-auto mb-16 stagger-parent">
        <p class="text-xs uppercase tracking-[0.18em] text-[#C76B50] mb-2 font-bold font-mono">Why NextReach Studio</p>
        <h2 id="why-heading" class="text-heading font-display font-bold text-[#1F1F23]">
          Enterprise engineering discipline.<br />Startup speed and pricing.
        </h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto stagger-parent">
        <div class="comparison-card comparison-card--negative">
          <div class="flex items-center gap-2 mb-4">
            <svg class="w-4 h-4 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            <h3 class="text-sm font-bold text-[#1F1F23] font-display">Traditional Agency Bloat</h3>
          </div>
          <ul class="space-y-3">
            <li class="flex gap-2.5 text-xs text-[#6E6862]"><span class="text-red-500 shrink-0 mt-0.5">✕</span>Account managers who relay messages between you and developers</li>
            <li class="flex gap-2.5 text-xs text-[#6E6862]"><span class="text-red-500 shrink-0 mt-0.5">✕</span>Weekly status meetings that substitute for actual progress</li>
            <li class="flex gap-2.5 text-xs text-[#6E6862]"><span class="text-red-500 shrink-0 mt-0.5">✕</span>Inflated hourly retainers that incentivize slow work</li>
            <li class="flex gap-2.5 text-xs text-[#6E6862]"><span class="text-red-500 shrink-0 mt-0.5">✕</span>"We'll scope it during the project" → surprise overruns</li>
          </ul>
        </div>

        <div class="comparison-card comparison-card--positive border-[#C76B50]/30">
          <div class="flex items-center gap-2 mb-4">
            <svg class="w-4 h-4 text-[#C76B50]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            <h3 class="text-sm font-bold text-[#C76B50] font-display">The NextReach Model</h3>
          </div>
          <ul class="space-y-3">
            <li class="flex gap-2.5 text-xs text-[#4A4844]"><span class="text-emerald-600 shrink-0 mt-0.5 font-bold">✓</span>Direct access to the senior engineer building your system</li>
            <li class="flex gap-2.5 text-xs text-[#4A4844]"><span class="text-emerald-600 shrink-0 mt-0.5 font-bold">✓</span>Fixed, transparent milestones with a written scope</li>
            <li class="flex gap-2.5 text-xs text-[#4A4844]"><span class="text-emerald-600 shrink-0 mt-0.5 font-bold">✓</span>Bi-weekly production sprints — working software, not slide decks</li>
            <li class="flex gap-2.5 text-xs text-[#4A4844]"><span class="text-emerald-600 shrink-0 mt-0.5 font-bold">✓</span>One-time project pricing. You own the finished product.</li>
          </ul>
        </div>
      </div>

      <div class="text-center mt-12 stagger-parent">
        <p class="text-[#6E6862] text-sm sm:text-base mb-6 font-body">
          Ready to ship your project?
        </p>
        <a href="/contact" class="btn-premium-primary">
          Schedule a Technical Discovery Call
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </section>

    <!-- ==================== BLOG / RESOURCES FOOTER ==================== -->
    <section class="py-20 px-6 sm:px-8 max-w-7xl mx-auto border-t border-[#1F1F23]/8" id="ai-dev-hub">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div>
          <p class="text-xs uppercase tracking-[0.18em] text-[#6E6862] mb-2 font-bold font-mono">Open Source & Community</p>
          <h2 class="text-heading font-display font-bold text-[#1F1F23] mb-4">
            Our Technical Depth
          </h2>
          <p class="text-[#6E6862] text-xs sm:text-sm leading-relaxed mb-6 font-body">
            We don't just build client apps. We actively build browser calculators, open-source libraries, and publish guides for AI developers, Claude Code users, and MCP builders.
          </p>
          <a href="/tools" class="text-sm text-[#C76B50] hover:text-[#D97A5E] transition-colors font-semibold">
            Explore our developer tools &rarr;
          </a>
        </div>

        <div class="lg:col-span-2 space-y-4">
          <h3 class="text-xs font-bold text-[#6E6862] uppercase tracking-wider mb-2 font-mono">Latest from our Blog &amp; Guides</h3>

          <div class="space-y-3">
            {latestPosts.map((post) => (
              <a href={`/blog/${post.id}`} class="card-studio hover:border-[#C76B50]/40 flex justify-between items-center py-3.5 px-5 group shadow-sm">
                <div>
                  <span class="text-[10px] text-[#8C847B] mr-3 font-mono">{post.data.pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span>
                  <span class="text-xs font-semibold text-[#1F1F23] group-hover:text-[#C76B50] transition-colors font-display">{post.data.title}</span>
                </div>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5 text-[#8C847B] group-hover:text-[#C76B50] transition-all duration-200 group-hover:translate-x-0.5">
                  <path d="M9 18l6-6-6-6"/>
                </svg>
              </a>
            ))}

            {latestGuides.slice(0, 1).map((guide: any) => (
              <a href={`/guides/${guide.id}`} class="card-studio hover:border-[#C76B50]/40 flex justify-between items-center py-3.5 px-5 group shadow-sm">
                <div>
                  <span class="badge-premium-neutral text-[9px] mr-3 uppercase font-mono">{guide.data.difficulty}</span>
                  <span class="text-xs font-semibold text-[#1F1F23] group-hover:text-[#C76B50] transition-colors font-display">{guide.data.title}</span>
                </div>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5 text-[#8C847B] group-hover:text-[#C76B50] transition-all duration-200 group-hover:translate-x-0.5">
                  <path d="M9 18l6-6-6-6"/>
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
