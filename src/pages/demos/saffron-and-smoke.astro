---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";

const demoUrl = "https://saffron-and-smoke-sigma.vercel.app";
---

<Layout
  title="Saffron & Smoke - Modern Indian Restaurant Demo"
  description="Experience Saffron & Smoke, a cinematic luxury restaurant website demo in Pune with interactive reservations, digital menus, and sub-second speed."
  image="/assets/demos/saffron-and-smoke/hero-dish.jpg"
>
  <Nav />

  <main class="min-h-screen bg-[#FAF8F5] text-[#1F1F23] pt-28 pb-20">
    <!-- Hero Showcase Header -->
    <section class="max-w-7xl mx-auto px-6 sm:px-8 mb-12">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md text-xs font-mono font-semibold bg-[#C76B50]/10 border border-[#C76B50]/25 text-[#C76B50]">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Live Production Demo
          </span>
          <span class="text-xs font-mono text-[#6E6862]">Baner, Pune</span>
        </div>
        <div class="flex items-center gap-3">
          <a
            href={demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-display font-semibold uppercase tracking-wider bg-[#C76B50] hover:bg-[#D97A5E] text-white shadow-[0_4px_16px_rgba(199,107,80,0.25)] transition-all hover:-translate-y-0.5"
          >
            Launch Standalone Website
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-8">
          <p class="text-xs font-mono text-[#C76B50] uppercase tracking-widest mb-2 font-bold">Hospitality &amp; Fine Dining Portfolio</p>
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif font-bold text-[#1F1F23] tracking-tight leading-tight">
            Saffron &amp; Smoke
          </h1>
          <p class="text-base sm:text-lg text-[#6E6862] mt-4 max-w-2xl font-normal leading-relaxed font-body">
            A cinematic, high-end digital flagship for a modern Indian dining atelier in Baner, Pune. Built for brands that demand an Architectural Digest standard rather than generic restaurant templates.
          </p>
        </div>

        <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3 justify-end">
          <div class="p-3.5 rounded-xl bg-white border border-[#1F1F23]/8 shadow-sm">
            <span class="text-[11px] font-mono text-[#6E6862] block uppercase font-semibold">Conversion Engine</span>
            <span class="text-sm font-semibold text-[#1F1F23]">Table Reservation + WhatsApp Routing</span>
          </div>
          <div class="p-3.5 rounded-xl bg-white border border-[#C76B50]/25 shadow-sm">
            <span class="text-[11px] font-mono text-[#6E6862] block uppercase font-semibold">Visual Benchmark</span>
            <span class="text-sm font-semibold text-[#C76B50]">Side-lit Chiaroscuro &amp; Organic Steam</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Live Preview Frame -->
    <section class="max-w-7xl mx-auto px-6 sm:px-8 mb-16">
      <div class="rounded-2xl border border-[#1F1F23]/10 bg-white shadow-2xl overflow-hidden">
        <!-- Mock Browser Top Bar -->
        <div class="bg-[#F0ECE4] px-4 py-3 border-b border-[#1F1F23]/8 flex items-center justify-between gap-4">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-400"></span>
            <span class="w-3 h-3 rounded-full bg-amber-400"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
          </div>
          <div class="flex-1 max-w-xl mx-auto">
            <div class="bg-white border border-[#1F1F23]/10 rounded-lg px-3 py-1.5 text-xs font-mono text-[#6E6862] flex items-center justify-between shadow-sm">
              <span class="flex items-center gap-2 truncate">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                https://saffron-and-smoke-sigma.vercel.app
              </span>
              <span class="text-[10px] text-[#8C847B] uppercase tracking-wider shrink-0">Edge Deployed</span>
            </div>
          </div>
          <div>
            <a
              href={demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-[#C76B50] hover:text-[#D97A5E] font-mono font-semibold flex items-center gap-1"
            >
              Open Fullscreen ↗
            </a>
          </div>
        </div>

        <!-- Iframe preview -->
        <div class="w-full h-[780px] bg-white relative">
          <iframe
            src={demoUrl}
            title="Saffron & Smoke Live Demo"
            class="w-full h-full border-0"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          ></iframe>
        </div>
      </div>
    </section>

    <!-- Case Study Highlights & Specs -->
    <section class="max-w-7xl mx-auto px-6 sm:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <div class="p-6 rounded-2xl bg-white border border-[#1F1F23]/8 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-[#C76B50]/10 border border-[#C76B50]/20 flex items-center justify-center text-[#C76B50] mb-4">
            🔥
          </div>
          <h3 class="text-lg font-bold text-[#1F1F23] mb-2 font-display">Cinematic Atmosphere</h3>
          <p class="text-sm text-[#6E6862] leading-relaxed font-body">
            Deep charcoal tones, warm terracotta accents, and an animated steam overlay on dramatic side-lit Indian cuisine photography.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-[#1F1F23]/8 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-[#C76B50]/10 border border-[#C76B50]/20 flex items-center justify-center text-[#C76B50] mb-4">
            📅
          </div>
          <h3 class="text-lg font-bold text-[#1F1F23] mb-2 font-display">Reservation Engine</h3>
          <p class="text-sm text-[#6E6862] leading-relaxed font-body">
            Interactive multi-guest booking flow with seating zone selection, instant reference code generation, and direct WhatsApp concierge handoff.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-[#1F1F23]/8 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-[#C76B50]/10 border border-[#C76B50]/20 flex items-center justify-center text-[#C76B50] mb-4">
            📍
          </div>
          <h3 class="text-lg font-bold text-[#1F1F23] mb-2 font-display">Local SEO Structured Data</h3>
          <p class="text-sm text-[#6E6862] leading-relaxed font-body">
            Embedded Schema.org Restaurant JSON-LD with geo coordinates in Baner, hours, pricing, and cuisine taxonomy for instant Google Maps discovery.
          </p>
        </div>
      </div>

      <!-- CTA to commission restaurant site -->
      <div class="rounded-2xl p-8 sm:p-12 bg-gradient-to-br from-white via-white to-[#C76B50]/8 border border-[#C76B50]/30 text-center shadow-md">
        <h2 class="text-2xl sm:text-4xl font-serif font-bold text-[#1F1F23] mb-4">
          Want a bespoke digital presence for your restaurant or lounge?
        </h2>
        <p class="text-[#6E6862] text-sm sm:text-base max-w-2xl mx-auto mb-8 font-body">
          NextReach Studio designs and deploys custom restaurant platforms with online table booking, digital menus, and local search dominance in 7-10 days.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/contact/"
            class="px-8 py-3.5 rounded-xl text-sm font-semibold uppercase tracking-wider bg-[#C76B50] hover:bg-[#D97A5E] text-white shadow-[0_4px_16px_rgba(199,107,80,0.25)] transition-all font-display"
          >
            Schedule a Demo Call
          </a>
          <a
            href={demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-3.5 rounded-xl text-sm font-semibold uppercase tracking-wider bg-white hover:bg-[#FAF8F5] border border-[#1F1F23]/12 text-[#1F1F23] transition-all font-mono shadow-sm"
          >
            Visit Live Demo Directly ↗
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
