---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import Prose from "@/components/Prose.astro";
import { getCollection, render } from "astro:content";
import { buildFaqPageSchema } from "@/utils/faq";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Mirrors the canonical Layout resolves, so the FAQPage @id points at the same URL the
// Article @id does. Null when this article has no "## Frequently Asked Questions" section.
const faqSchema = buildFaqPageSchema(post.body, post.data.canonicalURL || Astro.url.href);

// Escape "<" so authored content can never terminate the script element early. The FAQ
// answers are long-form prose on a site whose articles discuss HTML — cheap insurance.
const faqJson = faqSchema ? JSON.stringify(faqSchema).replace(/</g, "\\u003c") : null;
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  type="article"
  pubDate={post.data.pubDate}
  author={post.data.author}
  tags={post.data.tags}
  canonicalURL={post.data.canonicalURL}
>
  {faqJson && <script type="application/ld+json" set:html={faqJson} />}
  <Nav />
  <main class="pt-28 pb-20 relative overflow-hidden">
    <div class="absolute top-0 left-1/4 -translate-y-12 w-[400px] h-[250px] bg-[#c76b50]/8 rounded-full blur-[100px] pointer-events-none -z-10" aria-hidden="true"></div>
    <article class="px-6 sm:px-8 max-w-3xl mx-auto relative z-10">
      <header class="mb-12">
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <a href="/blog" class="text-xs text-[#6E6862] hover:text-[#1F1F23] transition-colors font-mono">
            ← All articles
          </a>
        </div>

        <h1 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-[#1F1F23] tracking-[-0.01em] leading-[1.2] mb-4">
          {post.data.title}
        </h1>
        <p class="text-lg text-[#6E6862] leading-relaxed mb-6 font-body">{post.data.description}</p>

        <div class="flex flex-wrap items-center gap-3 text-xs text-[#6E6862] font-mono">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
          </time>
          {post.data.updatedDate && (
            <>
              <span>·</span>
              <span>Updated {post.data.updatedDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</span>
            </>
          )}
          <span>·</span>
          <span>{post.data.author}</span>
          {(post.data.tags ?? []).length > 0 && (
            <>
              <span>·</span>
              <div class="flex gap-1.5 flex-wrap">
                {(post.data.tags ?? []).map((tag) => (
                  <span class="badge-premium-neutral text-[9px]">{tag}</span>
                ))}
              </div>
            </>
          )}
        </div>
      </header>

      <div class="card-studio rounded-2xl p-8 sm:p-10 mb-12">
        <Prose>
          <Content />
        </Prose>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-between items-start border-t border-[#1F1F23]/8 pt-8">
        <a href="/blog" class="inline-flex items-center gap-2 text-[#c76b50] hover:text-[#d97a5e] transition-colors text-sm font-medium font-mono">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          Back to all articles
        </a>
        <a href="/tools" class="inline-flex items-center gap-2 text-[#6E6862] hover:text-[#1F1F23] transition-colors text-sm font-mono">
          Browse free tools →
        </a>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
