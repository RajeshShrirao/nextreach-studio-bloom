---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import Prose from "@/components/Prose.astro";
---

<Layout
  title="Contact Us - Project Inquiry & Pricing Quote"
  description="Start a custom software project with NextReach Studio. Request a quote for web app development, business automation, MVPs, or AI integrations."
>
  <Nav />
  <main class="container-page relative">
    <div class="absolute top-0 left-1/4 -translate-y-12 w-[400px] h-[250px] bg-[#C76B50]/6 rounded-full blur-[100px] pointer-events-none -z-10" aria-hidden="true"></div>

    <header class="header-page animate-fade-in-up">
      <p class="header-page-pretitle font-mono text-[#C76B50] font-bold">Contact</p>
      <h1 class="header-page-title text-[#1F1F23]">Tell us what you need built</h1>
      <p class="header-page-subtitle text-[#6E6862]">
        Have a workflow to automate, a custom portal to build, or an MVP to launch? Let us know your goals, and we'll reply with clear next steps and pricing estimates.
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
      <!-- Contact Form -->
      <div class="lg:col-span-2 card-premium-flat shadow-sm">
        <form action="https://formspree.io/f/xbldeqzw" method="POST" class="space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="form-label-premium text-[#1F1F23]">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="form-input-premium"
                placeholder="Your name"
              />
            </div>
            <div>
              <label for="company" class="form-label-premium text-[#1F1F23]">Company Name / Website</label>
              <input
                type="text"
                id="company"
                name="company"
                class="form-input-premium"
                placeholder="e.g. Acme Trading"
              />
            </div>
          </div>

          <div>
            <label for="email" class="form-label-premium text-[#1F1F23]">Email Address</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="form-input-premium"
              placeholder="you@company.com"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="project-type" class="form-label-premium text-[#1F1F23]">Project / Engagement Type</label>
              <select
                id="project-type"
                name="project_type"
                required
                class="form-select-premium"
              >
                <option value="" disabled selected>Select a project type</option>
                <option value="pkg-quick-launch">⚡ Quick Launch Website (₹5,000)</option>
                <option value="pkg-business">💼 Business Website (₹7,500)</option>
                <option value="pkg-premium">✨ Premium Flagship Website (₹10,000)</option>
                <option value="web-app">Custom Web Application / SaaS</option>
                <option value="ai-agent">Autonomous AI Agent &amp; Workflows</option>
                <option value="automation">Business Process Automation / API Syncer</option>
                <option value="mvp">Rapid MVP Engineering (4-6 Weeks)</option>
                <option value="other">Bespoke Architectural Advisory</option>
              </select>
            </div>

            <div>
              <label for="budget" class="form-label-premium text-[#1F1F23]">Investment Range</label>
              <select
                id="budget"
                name="budget"
                required
                class="form-select-premium"
              >
                <option value="" disabled selected>Select an investment tier</option>
                <option value="inr-5k-10k">₹5,000 - ₹10,000 (Website Launch Packages)</option>
                <option value="inr-10k-50k">₹10,000 - ₹50,000 (Multi-Page / Custom)</option>
                <option value="inr-50k-plus">₹50,000+ (Full Platform / AI Agent)</option>
                <option value="usd-1k-3k">$1,000 - $3,000 USD (Startup MVP)</option>
                <option value="usd-3k-plus">$3,000+ USD (Enterprise Architecture)</option>
              </select>
            </div>
          </div>

          <div>
            <label for="message" class="form-label-premium text-[#1F1F23]">Project Details / Requirements</label>
            <textarea
              id="message"
              name="message"
              rows={5}
              required
              class="form-textarea-premium"
              placeholder="Describe what business challenge you want to solve, what database features you need, or what flow you have in mind..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="btn-premium-primary w-full sm:w-auto"
          >
            Send Inquiry
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-4 h-4">
              <line x1="22" y1="2" x2="11" y2="13"/>
              <polygon points="22 2 15 22 11 13 2 9 22 2"/>
            </svg>
          </button>
        </form>
      </div>

      <!-- Quick Contact Info -->
      <div class="space-y-6">
         <div class="card-premium shadow-sm">
           <h2 class="text-xs font-bold text-[#1F1F23] uppercase tracking-wider mb-3 font-mono">Direct Chat</h2>
          <p class="text-xs text-[#6E6862] leading-relaxed mb-4">
            Need a fast reply or want to share details on chat? Message us directly on WhatsApp.
          </p>
          <a
            href="https://wa.me/919822379976?text=Hi%2C%20I%20have%20a%20software%20project%20inquiry%20for%20NextReach%20Studio."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-premium-secondary flex items-center justify-center gap-2 w-full text-center font-semibold"
          >
            <span>💬 Chat on WhatsApp</span>
          </a>
        </div>

        <div class="card-premium shadow-sm">
           <h2 class="text-xs font-bold text-[#1F1F23] uppercase tracking-wider mb-3 font-mono">Studio Details</h2>
          <ul class="space-y-3.5 text-xs text-[#6E6862]">
            <li class="flex gap-2">
              <span class="text-[#C76B50]">📍</span>
              <span>Serving Pune, Pimpri-Chinchwad &amp; Maharashtra, India</span>
            </li>
            <li class="flex gap-2">
              <span class="text-[#C76B50]">✉️</span>
              <a href="mailto:hello@nextreachstudio.in" class="hover:text-[#C76B50] transition-colors">hello@nextreachstudio.in</a>
            </li>
            <li class="flex gap-2">
              <span class="text-[#C76B50]">📱</span>
              <a href="tel:+919822379976" class="hover:text-[#C76B50] transition-colors">+91 98223 79976</a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <Prose>
      <h2>What happens next?</h2>
      <ol>
        <li><strong>Discovery:</strong> We will review your inquiry details within 24-48 business hours.</li>
        <li><strong>clarifying Questions:</strong> If we need more information about your database structure or external APIs, we'll reach out via email or WhatsApp.</li>
        <li><strong>Fixed Proposal:</strong> We will provide a clean scope proposal including an exact, one-time project cost and timeline.</li>
      </ol>
    </Prose>
  </main>
  <Footer />
</Layout>
