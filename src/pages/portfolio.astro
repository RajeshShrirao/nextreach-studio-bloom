---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";

const projects = [
  {
    category: "Luxury Hospitality & Booking Engine",
    title: "Saffron & Smoke — Modern Indian Dining",
    description: "A cinematic, high-end digital flagship and online table booking engine for an upscale modern Indian dining atelier in Baner, Pune.",
    problem: "Fine-dining establishments often surrender guest data and brand identity to aggregator platforms that charge commissions and provide generic, slow mobile interfaces.",
    built: "An Architectural Digest inspired web platform featuring chiaroscuro photography, custom steam animations, interactive multi-sitting table reservations, and WhatsApp concierge integration.",
    tech: ["HTML5", "Vanilla CSS", "JavaScript", "Schema.org", "Vercel Edge"],
    outcome: "Created a luxury digital brand presence, enabled direct zero-commission table reservations, and achieved sub-second FCP on mobile.",
    image: "/assets/demos/saffron-and-smoke/hero-dish.jpg",
    status: "Live Production Demo",
    demoUrl: "https://saffron-and-smoke-sigma.vercel.app",
    demoInternalUrl: "/demos/saffron-and-smoke"
  },
  {
    category: "Workflow Automation & Management",
    title: "Employee & Crew Scheduling System",
    description: "Built for a regional field service company experiencing communication bottlenecks with paper crew logs.",
    problem: "Scheduling crew shifts and reporting dispatch logs via spreadsheet was causing double-booking issues and delayed client notifications.",
    built: "A secure internal dispatch calendar and custom database interface that allows managers to schedule shifts and field workers to check off jobs from mobile browsers.",
    tech: ["Next.js", "PostgreSQL", "Tailwind CSS", "Twilio API"],
    outcome: "Reduced scheduling conflicts, eliminated duplicate entry, and enabled same-day client reporting.",
    image: "/scheduling_app.png",
    status: "Active System"
  },
  {
    category: "Business Operations",
    title: "Inventory & Order Workflow Automation",
    description: "An automated lead-to-order pipeline for a wholesale trade merchant.",
    problem: "The merchant received order inquiries via WhatsApp and email, then manually typed them into an inventory tracking spreadsheet, causing entry backlogs during busy shipping seasons.",
    built: "An email parser and simple admin dashboard that extracts incoming order records, logs details to a central database, and updates stock balances automatically.",
    tech: ["Python", "Flask", "PostgreSQL", "Gmail API"],
    outcome: "Eliminated daily manual logging backlogs, offering real-time inventory visibility to sales representatives.",
    image: "/inventory_workflow.png",
    status: "Active System"
  },
  {
    category: "Customer Acquisition",
    title: "Service Business Web Portal & Lead Form",
    description: "A fast, clean lead capture and inquiry rating portal for a professional services company.",
    problem: "An outdated corporate website was failing to capture leads and could not pre-qualify service categories, resulting in wasted sales consultation hours.",
    built: "A highly optimized, responsive landing page with an interactive project cost calculator and instant WhatsApp redirect API.",
    tech: ["Astro", "Tailwind CSS", "JavaScript"],
    outcome: "Created a professional online presence with direct lead qualification, saving manual follow-up time.",
    image: "/lead_portal.png",
    status: "Active System"
  },
  {
    category: "SME Admin Dashboards",
    title: "SME KPI Dashboard & API Syncer",
    description: "Built for a logistics company needing a single screen to review operations from multiple platforms.",
    problem: "Operational data was scattered across shipping portals and third-party accounting applications, requiring hours of manual reports weekly.",
    built: "A consolidated dashboard pulling API records every night, organizing key performance indicators (KPIs) into a unified visual display.",
    tech: ["Next.js", "Python (Cron Jobs)", "PostgreSQL", "Vercel"],
    outcome: "Gave management immediate daily operations visibility, eliminating manual data assembly.",
    image: "/kpi_dashboard.png",
    status: "Completed"
  }
];

const placeholders = [
  {
    category: "AI Integrations",
    title: "AI Document Processor & Search",
    tech: ["OpenAI API", "Python", "Vector DB"],
    teaser: "A tool to parse long vendor invoices, categorize items automatically, and support natural-language querying of historical contract documents."
  },
  {
    category: "Mobile Applications",
    title: "Local Delivery Tracker Mobile App",
    tech: ["Flutter", "Go Backend", "Postgres"],
    teaser: "A lightweight cross-platform mobile tracker for delivery dispatchers, updating delivery coordinates securely."
  }
];

const stats = [
  { value: "4", label: "Delivered Systems", sub: "all active in production" },
  { value: "100%", label: "On-Time Delivery", sub: "every project scoped to completion" },
  { value: "Senior", label: "Direct Engineer Access", sub: "no account managers, no handoffs" },
  { value: "2-4 wk", label: "Sprint Cycles", sub: "bi-weekly working software" },
];
---

<Layout
  title="Our Portfolio — Recent Custom Software Projects"
  description="View our custom software portfolio — real-world business automation, web applications, and MVPs built for SMEs and startups under fixed-scope contracts."
>
  <Nav />
  <main>
    <!-- ==================== HERO ==================== -->
    <section class="container-hero relative overflow-hidden">
      <div class="absolute top-0 left-1/2 w-[700px] h-[400px] bg-amber-400/8 rounded-full blur-[130px] pointer-events-none -z-10 animate-mesh-1" aria-hidden="true"></div>
      <div class="absolute top-12 left-[40%] w-[500px] h-[300px] bg-yellow-500/5 rounded-full blur-[110px] pointer-events-none -z-10 animate-mesh-2" aria-hidden="true"></div>

      <div class="text-center relative z-10 mb-14 stagger-parent">
        <p class="badge-premium-accent text-[10px] font-bold px-3 py-1 inline-flex mb-5">
          Portfolio
        </p>
        <h1 class="text-hero text-white mb-6 font-display font-bold text-balance-wide">
          Production software<br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-amber-400 to-yellow-500 glow-text">built for real businesses.</span>
        </h1>
        <p class="text-zinc-400 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-10 font-body">
          We focus on functional, reliable applications that solve business problems. No generic templates, no inflated results — just honest software built to scope.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/contact" class="btn-premium-primary">
            Start Your Project
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="/services" class="btn-premium-secondary">
            View Our Services
          </a>
        </div>

        <!-- Trust Metrics -->
        <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl mx-auto text-left">
          {stats.map((s) => (
            <div class="dashboard-panel p-3.5 text-center sm:text-left">
              <p class="text-base sm:text-lg font-bold text-white font-display tracking-tight">{s.value}</p>
              <p class="text-xs font-semibold text-amber-400 font-display mb-0.5">{s.label}</p>
              <p class="text-[10px] text-zinc-500 leading-relaxed font-body">{s.sub}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ==================== PROJECT LIST ==================== -->
    <div class="max-w-5xl mx-auto px-6 sm:px-8 mb-20 stagger-parent">
      <div class="flex items-center gap-3 mb-10">
        <div class="flex-1 h-px bg-zinc-800/60"></div>
        <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-[0.2em] font-display">Delivered Work</span>
        <div class="flex-1 h-px bg-zinc-800/60"></div>
      </div>

      <div class="space-y-14">
        {projects.map((project, idx) => (
          <div class="group card-cyber p-0 border border-zinc-800/80 hover:border-amber-400/25 transition-all duration-300">
            <div class="flex flex-col lg:flex-row items-stretch">
              <!-- Project Image -->
              <div class="lg:w-[42%] relative overflow-hidden bg-zinc-950 flex items-center justify-center border-b lg:border-b-0 lg:border-r border-zinc-800/80 aspect-video lg:aspect-auto">
                <img
                  src={project.image}
                  alt={`${project.title} — ${project.category}`}
                  width="640"
                  height="480"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 group-hover:opacity-90"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-transparent to-transparent opacity-60"></div>
                <span class="absolute top-3 left-3 text-[9px] font-bold text-zinc-600 font-mono">0{idx + 1}</span>
              </div>

              <!-- Project Details -->
              <div class="lg:w-[58%] p-6 sm:p-8 flex flex-col justify-between space-y-5">
                <div>
                  <div class="flex items-center justify-between gap-3 mb-3">
                    <span class="inline-flex items-center gap-1.5 text-[10px] font-bold text-amber-500 uppercase tracking-[0.15em] font-display">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-400 shadow-[0_0_6px_rgba(251,191,36,0.5)]"></span>
                      {project.category}
                    </span>
                    <span class="flex items-center gap-1 text-[9px] font-semibold text-emerald-400 font-mono">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.5)]"></span>
                      {project.status}
                    </span>
                  </div>

                  <h2 class="text-xl sm:text-2xl font-bold text-white font-display mb-2 transition-colors group-hover:text-amber-300">{project.title}</h2>
                  <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed font-body">{project.description}</p>
                </div>

                <!-- Spec grid -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-zinc-900/60">
                  <div>
                    <h4 class="flex items-center gap-1 text-[9px] font-bold text-zinc-500 uppercase tracking-[0.12em] mb-1 font-display">
                      <svg class="w-3 h-3 text-zinc-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                      Challenge
                    </h4>
                    <p class="text-xs text-zinc-500 leading-relaxed font-body">{project.problem}</p>
                  </div>
                  <div>
                    <h4 class="flex items-center gap-1 text-[9px] font-bold text-zinc-500 uppercase tracking-[0.12em] mb-1 font-display">
                      <svg class="w-3 h-3 text-zinc-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                      Solution
                    </h4>
                    <p class="text-xs text-zinc-500 leading-relaxed font-body">{project.built}</p>
                  </div>
                  <div>
                    <h4 class="flex items-center gap-1 text-[9px] font-bold text-zinc-500 uppercase tracking-[0.12em] mb-1 font-display">
                      <svg class="w-3 h-3 text-zinc-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                      Outcome
                    </h4>
                    <p class="text-xs text-zinc-500 leading-relaxed font-body">{project.outcome}</p>
                  </div>
                </div>

                <!-- Tech badges -->
                <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-zinc-900/40">
                  <div class="flex flex-wrap gap-1.5 items-center">
                    <span class="text-[9px] text-zinc-600 font-mono mr-1 self-center">Stack</span>
                    {project.tech.map((t) => (
                      <span class="badge-premium-neutral text-[9px] font-semibold tracking-wide font-mono">{t}</span>
                    ))}
                  </div>

                  {(project as any).demoUrl && (
                    <div class="flex items-center gap-3">
                      <a
                        href={(project as any).demoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-xs font-semibold text-amber-400 hover:text-amber-300 flex items-center gap-1 font-mono transition-colors"
                      >
                        Launch Demo ↗
                      </a>
                      {(project as any).demoInternalUrl && (
                        <a
                          href={(project as any).demoInternalUrl}
                          class="text-xs text-zinc-400 hover:text-white flex items-center gap-1 font-mono transition-colors"
                        >
                          Dossier →
                        </a>
                      )}
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ==================== PLANNED PROJECTS ==================== -->
    <div class="max-w-5xl mx-auto px-6 sm:px-8 mb-20">
      <div class="gradient-divider mb-14"></div>

      <div class="text-center mb-12 stagger-parent">
        <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-amber-500 mb-2 font-display">Coming Soon</p>
        <h2 class="font-display font-bold text-heading text-white">Case studies in progress</h2>
        <p class="text-zinc-400 text-sm mt-2 max-w-xl mx-auto font-body">
          We are wrapping up the initial scoped versions of these projects. Full details will be published once code is deployed.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 stagger-parent">
        {placeholders.map((ph) => (
          <div class="card-cyber-accent hover:border-amber-400/25 transition-all duration-300">
            <div class="flex items-center justify-between gap-3 mb-3">
              <span class="text-[9px] font-bold text-zinc-500 uppercase tracking-widest font-display">{ph.category}</span>
              <span class="text-[9px] text-amber-500 font-semibold uppercase tracking-wider bg-amber-500/5 px-2.5 py-0.5 rounded-full border border-amber-500/10">In Development</span>
            </div>
            <h3 class="text-base font-semibold text-white font-display mb-1.5">{ph.title}</h3>
            <p class="text-xs text-zinc-400 leading-relaxed mb-4 font-body">{ph.teaser}</p>
            <div class="flex flex-wrap gap-1.5 pt-3 border-t border-zinc-900/40">
              {ph.tech.map((t) => (
                <span class="badge-premium-neutral text-[9px] font-mono">{t}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ==================== CTA ==================== -->
    <section class="py-20 px-6 sm:px-8 max-w-5xl mx-auto border-t border-zinc-900/60">
      <div class="text-center stagger-parent">
        <p class="text-xs uppercase tracking-[0.18em] text-amber-500 mb-2 font-bold font-display">Ready to Build?</p>
        <h2 class="text-heading font-display font-bold text-white mb-4">
          Have a project in mind?
        </h2>
        <p class="text-zinc-400 text-sm sm:text-base max-w-xl mx-auto mb-8 font-body leading-relaxed">
          Tell us what you need built. We'll reply with a clear scope, timeline, and fixed price — no meetings required upfront.
        </p>
        <a href="/contact" class="btn-premium-primary">
          Start Your Project
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
